#!/bin/sh
# S95motion-detectd -- motion-detect 系统服务（出厂常驻，不占 App Center）
#
# 程序在 rootfs：/usr/share/motion-detect/（只读，恢复出厂不丢）
# 配置在 /userdata/local/motion-detect/config.json（可在线修改；恢复出厂后
# 从 rootfs 默认配置重新生成）。
#
# 注意：/userdata 是个体持久分区，其 config.json 出厂后由用户修改过则保留。

CONF_DIR=/userdata/local/motion-detect
CONF=$CONF_DIR/config.json
DEFAULTS=/usr/share/motion-detect/config.json
LOG=/userdata/local/motion-detect/daemon.log
PIDFILE=/var/run/motion-detectd.pid

case "$1" in
start)
	mkdir -p "$CONF_DIR"
	[ -f "$CONF" ] || cp "$DEFAULTS" "$CONF"
	if [ -f "$PIDFILE" ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null; then
		echo "motion-detectd already running" >&2
		exit 0
	fi
	cd /usr/share/motion-detect
	nohup /usr/bin/python3 motion_daemon.py --config "$CONF" \
		>>"$LOG" 2>&1 &
	echo $! > "$PIDFILE"
	;;
stop)
	if [ -f "$PIDFILE" ]; then
		kill "$(cat $PIDFILE)" 2>/dev/null
		rm -f "$PIDFILE"
	fi
	;;
restart)
	$0 stop
	sleep 1
	$0 start
	;;
*)
	echo "usage: $0 {start|stop|restart}" >&2
	exit 1
	;;
esac
exit 0
