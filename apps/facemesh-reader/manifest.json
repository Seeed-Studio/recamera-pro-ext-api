{
  "manifest_version": 2,
  "release": {"sequence": 3, "channel": "stable"},
  "compatibility": {
    "platform_profile": "rv1126b-linux-gnu-cp311-rknn232-v1",
    "arch": "aarch64", "python": "==3.11.*",
    "kit_api": ">=0.1,<1", "sdk_abi": ">=1.3,<2", "rknn_runtime": "==2.3.2"
  },
  "python": {"runtime_profile": "recamera-ai-cp311-v1", "isolation": "per-release", "wheels": [], "imports": []},
  "artifacts": [
    {
      "id": "face-detector", "kind": "rknn", "source": "bundled",
      "file": "models/yolov8n_face_rawhead_fp16.rknn",
      "sha256": "2bd39fb861b4ceb9cfa8a2d1b5c7c8d83a9d4a711636ccb3a88c1aec0801a524",
      "size": 7106678, "mount": "models/yolov8n_face_rawhead_fp16.rknn",
      "required": true, "share_scope": "content"
    },
    {
      "id": "face-landmarks", "kind": "rknn", "source": "bundled",
      "file": "models/face_landmark_fp16.rknn",
      "sha256": "9b6b39ed295971dd0d044c10e80625de0376dd850514b2ef25da5f25d29e986d",
      "size": 1457446, "mount": "models/face_landmark_fp16.rknn",
      "required": true, "share_scope": "content"
    }
  ],
  "resources": {
    "claims": [
      {"name": "camera.frames", "mode": "shared", "required": true},
      {"name": "npu.rknn", "mode": "scheduled", "required": true},
      {"name": "rga", "mode": "shared", "required": true},
      {"name": "result.publish", "mode": "brokered", "required": true}
    ],
    "limits": {"memory_mb": 384, "cpu_percent": 300, "storage_mb": 48, "shutdown_grace_sec": 10}
  },
  "permissions": {
    "sdk": ["frame.read", "npu.infer", "rga.use", "result.publish"],
    "filesystem": {"read": ["app", "artifacts"], "write": ["appdata", "tmp"]},
    "network": {"listen": [], "outbound": ["configured.outputs"]}
  },
  "health": {
    "protocol": "kit-health-v1", "startup_timeout_sec": 120,
    "stabilization_sec": 3, "liveness_interval_sec": 10, "liveness_failures": 3,
    "restart": {"policy": "on-failure", "max_attempts": 3, "window_sec": 300, "backoff_sec": [1, 5, 15]}
  },
  "instances": {"max": 1, "config_scope": "app", "data_scope": "app", "endpoint_mode": "allocated"},
  "id": "facemesh-reader",
  "name": "Facemesh Reader",
  "name_zh": "面部疲劳检测",
  "version": "0.1.2",
  "image": "/appcenter/apps/facemesh-reader.png",
  "icon": {"path": "icon.png", "media_type": "image/png"},
  "type": "self-hosted",
  "scene": "Safety & Care",
  "scene_zh": "安全看护",
  "description": "On-device drowsiness / fatigue detection with a two-stage face cascade: a YOLOv8n-face detector finds the face, a 468-point MediaPipe FaceMesh landmark model runs on the cropped face ROI, then explainable CPU-only temporal logic derives EAR (eye aspect ratio), MAR (mouth aspect ratio), blinks, yawns and a composite drowsiness state. First reference for the reCamera Pro cascade-pipeline pattern reused by face-analysis.",
  "description_zh": "设备端困倦/疲劳检测，采用两级人脸级联：YOLOv8n-face 检测人脸，468 点 MediaPipe FaceMesh 关键点模型在裁剪的人脸 ROI 上运行，再由可解释的纯 CPU 时序逻辑计算 EAR（眼纵横比）、MAR（嘴纵横比）、眨眼、打哈欠与综合困倦状态。是 reCamera Pro 级联流水线范式的首个参考，供 face-analysis 复用。",
  "author": "Seeed reCamera Pro",
  "entry": "app.py",
  "capabilities": [
    "output"
  ],
  "models": [
    {
      "id": "yolov8n_face_rawhead_fp16",
      "file": "models/yolov8n_face_rawhead_fp16.rknn",
      "task": "detect",
      "input": [
        1,
        640,
        640,
        3
      ],
      "quant": "fp16",
      "classes": [
        "face"
      ],
      "role": "stage1_detector"
    },
    {
      "id": "face_landmark_fp16",
      "file": "models/face_landmark_fp16.rknn",
      "task": "landmark",
      "input": [
        1,
        192,
        192,
        3
      ],
      "quant": "fp16",
      "keypoints": "facemesh468",
      "role": "stage2_landmark"
    }
  ],
  "x-default_model": "yolov8n_face_rawhead_fp16",
  "postproc": "face_detect",
  "render": {
    "schema_version": 1,
    "keypoints": {
      "layout": "facemesh468",
      "point_radius": 1,
      "skeleton": []
    }
  },
  "output": {
    "contract_version": 2,
    "sink": "ws",
    "schema": "results[]{box,score,presence,landmark_count,ear,mar} + events[]{kind=metrics|blink|yawn|drowsiness,avg_ear,mar,state,drowsiness_level,perclos_pct,...}",
    "default_channel": [
      "ws"
    ],
    "default_mode": "raw",
    "fields": [
      {"name": "box", "from": "results[].box", "type": "bbox<float>[4]", "coord": "pixel_xyxy", "description": "Face box, original-frame xyxy pixels"},
      {"name": "score", "from": "results[].score", "type": "float", "description": "Face detection confidence"},
      {"name": "kind", "from": "results[].kind", "type": "string", "description": "Result kind, always 'face'"},
      {"name": "presence", "from": "results[].presence", "type": "float", "description": "Landmark presence score"},
      {"name": "landmark_count", "from": "results[].landmark_count", "type": "integer", "description": "Number of FaceMesh landmarks (468 when present)"},
      {"name": "ear", "from": "results[].ear", "type": "float", "optional": true, "description": "Eye aspect ratio (primary face)"},
      {"name": "mar", "from": "results[].mar", "type": "float", "optional": true, "description": "Mouth aspect ratio (primary face)"},
      {"name": "keypoints", "from": "results[].keypoints", "type": "keypoints<float>[]", "coord": "pixel_points", "optional": true, "description": "468 FaceMesh pixel keypoints"},
      {"name": "metrics_face_valid", "from": "events[kind=metrics].face_valid", "type": "bool", "event_kind": "metrics", "description": "Whether a valid face drives the metrics"},
      {"name": "metrics_avg_ear", "from": "events[kind=metrics].avg_ear", "type": "float", "event_kind": "metrics", "description": "Average EAR"},
      {"name": "metrics_left_ear", "from": "events[kind=metrics].left_ear", "type": "float", "event_kind": "metrics", "description": "Left-eye EAR"},
      {"name": "metrics_right_ear", "from": "events[kind=metrics].right_ear", "type": "float", "event_kind": "metrics", "description": "Right-eye EAR"},
      {"name": "metrics_mar", "from": "events[kind=metrics].mar", "type": "float", "event_kind": "metrics", "description": "Mouth aspect ratio"},
      {"name": "metrics_eyes_closed", "from": "events[kind=metrics].eyes_closed", "type": "bool", "event_kind": "metrics", "description": "Eyes-closed flag"},
      {"name": "metrics_mouth_open", "from": "events[kind=metrics].mouth_open", "type": "bool", "event_kind": "metrics", "description": "Mouth-open flag"},
      {"name": "metrics_state", "from": "events[kind=metrics].state", "type": "string", "event_kind": "metrics", "description": "Composite drowsiness state"},
      {"name": "metrics_drowsiness_level", "from": "events[kind=metrics].drowsiness_level", "type": "float", "event_kind": "metrics", "description": "Drowsiness level"},
      {"name": "metrics_perclos_pct", "from": "events[kind=metrics].perclos_pct", "type": "float", "event_kind": "metrics", "description": "PERCLOS percentage"},
      {"name": "metrics_continuous_closure_sec", "from": "events[kind=metrics].continuous_closure_sec", "type": "float", "event_kind": "metrics", "description": "Continuous eye-closure seconds"},
      {"name": "metrics_is_yawning", "from": "events[kind=metrics].is_yawning", "type": "bool", "event_kind": "metrics", "description": "Currently yawning"},
      {"name": "metrics_yawn_count_5min", "from": "events[kind=metrics].yawn_count_5min", "type": "integer", "event_kind": "metrics", "description": "Yawns in the last 5 minutes"},
      {"name": "metrics_alert_active", "from": "events[kind=metrics].alert_active", "type": "bool", "event_kind": "metrics", "description": "Drowsiness alert active"},
      {"name": "blink_kind", "from": "events[kind=blink].kind", "type": "string", "event_kind": "blink", "description": "Blink edge event"},
      {"name": "yawn_kind", "from": "events[kind=yawn].kind", "type": "string", "event_kind": "yawn", "description": "Yawn edge event"},
      {"name": "drowsiness_kind", "from": "events[kind=drowsiness].kind", "type": "string", "event_kind": "drowsiness", "description": "Drowsiness edge event"}
    ],
    "default_mapping": [
      {"source": "(events.metrics | last).state", "target": "state", "topic": "recamera/{{ app }}/metrics", "task": "keypoint"},
      {"source": "(events.metrics | last).alert_active", "target": "alert_active", "topic": "recamera/{{ app }}/metrics", "task": "keypoint"},
      {"source": "(events.metrics | last).avg_ear", "target": "avg_ear", "topic": "recamera/{{ app }}/metrics", "task": "keypoint"},
      {"source": "(events.metrics | last).perclos_pct", "target": "perclos_pct", "topic": "recamera/{{ app }}/metrics", "task": "keypoint"},
      {"source": "(events.metrics | last).is_yawning", "target": "is_yawning", "topic": "recamera/{{ app }}/metrics", "task": "keypoint"},
      {"source": "detection.count", "target": "face_count", "topic": "recamera/{{ app }}/count", "task": "keypoint"},
      {"source": "events.blink | length", "target": "blink_count", "topic": "recamera/{{ app }}/edges", "task": "keypoint"},
      {"source": "events.yawn | length", "target": "yawn_count", "topic": "recamera/{{ app }}/edges", "task": "keypoint"}
    ]
  },
  "config_schema": {
    "groups": [
      {
        "key": "detection",
        "title": "Face detection",
        "title_zh": "人脸检测",
        "items": [
          {
            "key": "confidence",
            "type": "number",
            "apply": "live",
            "title": "Face confidence",
            "title_zh": "人脸置信度",
            "min": 0.05,
            "max": 0.95,
            "step": 0.05,
            "default": 0.4
          },
          {
            "key": "iou",
            "type": "number",
            "apply": "live",
            "title": "NMS IoU",
            "title_zh": "NMS IoU",
            "min": 0.1,
            "max": 0.9,
            "step": 0.05,
            "default": 0.45
          },
          {
            "key": "crop_pad",
            "type": "number",
            "apply": "live",
            "title": "Face ROI padding",
            "title_zh": "人脸 ROI 外扩",
            "min": 0.0,
            "max": 1.0,
            "step": 0.05,
            "default": 0.25
          },
          {
            "key": "presence_threshold",
            "type": "number",
            "apply": "live",
            "title": "Landmark presence",
            "title_zh": "关键点存在阈值",
            "min": 0.0,
            "max": 1.0,
            "step": 0.05,
            "default": 0.5
          }
        ]
      },
      {
        "key": "metrics",
        "title": "EAR / MAR thresholds",
        "title_zh": "EAR / MAR 阈值",
        "items": [
          {
            "key": "ear_threshold",
            "type": "number",
            "apply": "live",
            "title": "Eye-closed EAR",
            "title_zh": "闭眼 EAR 阈值",
            "min": 0.1,
            "max": 0.4,
            "step": 0.01,
            "default": 0.21
          },
          {
            "key": "mar_threshold",
            "type": "number",
            "apply": "live",
            "title": "Yawn MAR",
            "title_zh": "打哈欠 MAR 阈值",
            "min": 0.3,
            "max": 1.2,
            "step": 0.05,
            "default": 0.65
          },
          {
            "key": "yawn_consecutive_frames",
            "type": "integer",
            "apply": "live",
            "title": "Yawn hold frames",
            "title_zh": "打哈欠持续帧数",
            "min": 1,
            "max": 30,
            "step": 1,
            "default": 5
          }
        ]
      },
      {
        "key": "drowsiness",
        "title": "Drowsiness timing",
        "title_zh": "困倦时序",
        "items": [
          {
            "key": "ear_continuous_sec",
            "type": "number",
            "apply": "live",
            "title": "Continuous-closure (s)",
            "title_zh": "连续闭眼（秒）",
            "min": 0.2,
            "max": 10.0,
            "step": 0.1,
            "default": 2.0
          },
          {
            "key": "perclos_window_sec",
            "type": "number",
            "apply": "restart",
            "title": "PERCLOS window (s)",
            "title_zh": "PERCLOS 窗口（秒）",
            "min": 5.0,
            "max": 120.0,
            "step": 5.0,
            "default": 60.0
          },
          {
            "key": "perclos_critical_pct",
            "type": "number",
            "apply": "live",
            "title": "PERCLOS critical %",
            "title_zh": "PERCLOS 临界百分比",
            "min": 5.0,
            "max": 60.0,
            "step": 1.0,
            "default": 20.0
          },
          {
            "key": "alert_cooldown_sec",
            "type": "number",
            "apply": "live",
            "title": "Alert cooldown (s)",
            "title_zh": "报警冷却（秒）",
            "min": 0.0,
            "max": 30.0,
            "step": 0.5,
            "default": 5.0
          },
          {
            "key": "yawn_count_threshold",
            "type": "integer",
            "apply": "live",
            "title": "Yawns/5min for drowsy",
            "title_zh": "5 分钟打哈欠数阈值",
            "min": 1,
            "max": 10,
            "step": 1,
            "default": 3
          }
        ]
      },
      {
        "key": "display",
        "title": "Overlay display",
        "title_zh": "画面显示",
        "items": [
          {
            "key": "point_radius",
            "type": "integer",
            "apply": "live",
            "title": "Landmark dot radius (px)",
            "title_zh": "关键点半径（像素）",
            "min": 1,
            "max": 6,
            "step": 1,
            "default": 1
          }
        ]
      }
    ]
  },
  "ha_entities": [
    {
      "component": "binary_sensor",
      "object_id": "drowsiness",
      "name": "Drowsiness Alert",
      "value_template": "{{ 'ON' if value_json.summary.alert_active else 'OFF' }}",
      "device_class": "problem"
    },
    {
      "component": "binary_sensor",
      "object_id": "yawn",
      "name": "Yawning",
      "value_template": "{{ 'ON' if value_json.summary.is_yawning else 'OFF' }}",
      "icon": "mdi:sleep"
    },
    {
      "component": "binary_sensor",
      "object_id": "occupancy",
      "name": "Face Detected",
      "value_template": "{{ 'ON' if value_json.results_count > 0 else 'OFF' }}",
      "device_class": "occupancy"
    },
    {
      "component": "sensor",
      "object_id": "perclos",
      "name": "PERCLOS",
      "value_template": "{{ value_json.summary.perclos_pct | default(0) }}",
      "unit_of_measurement": "%",
      "state_class": "measurement"
    },
    {
      "component": "sensor",
      "object_id": "ear",
      "name": "Eye Aspect Ratio",
      "value_template": "{{ value_json.summary.avg_ear | default(0) }}",
      "state_class": "measurement"
    }
  ]
}
