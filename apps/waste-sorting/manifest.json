  "config_schema": {
    "groups": [
      {
        "key": "publish",
        "title": "Publishing",
        "title_zh": "发布",
        "items": [
          {
            "key": "stream_id",
            "type": "string",
            "apply": "restart",
            "title": "Stream ID",
            "title_zh": "流 ID",
            "default": "recamera-pro",
            "help": "Stable identifier for this camera. It goes into every event payload and into the default topic, so several devices publishing to one broker stay separable. Consumers must read it from the payload, never parse it out of the topic.",
            "help_zh": "这台相机的稳定标识。它会进每一条事件的 payload，也会进默认 topic，多台设备发到同一个 broker 才分得开。消费方必须从 payload 里读它，不要去解析 topic。"
          },
          {
            "key": "min_confidence",
            "type": "number",
            "apply": "live",
            "title": "Confidence floor",
            "title_zh": "置信度下限",
            "default": 0.5,
            "min": 0.05,
            "max": 0.99,
            "step": 0.05,
            "help": "A frame below this confidence does not count towards the stable run, and a published event below it carries the residual fallback category instead of the argmax. Raising it makes the device quieter, lowering it publishes more marginal calls.",
            "help_zh": "低于这个置信度的帧不计入连续计数；真发出去的事件若低于它，类别改判为兜底的「其他垃圾」而不是 argmax。调高更安静，调低会把更多勉强的判定发出去。"
          },
          {
            "key": "consecutive_frames",
            "type": "integer",
            "apply": "live",
            "title": "Debounce frames",
            "title_zh": "去抖帧数",
            "default": 3,
            "min": 1,
            "max": 60,
            "help": "How many consecutive frames of the same class above the confidence floor count as stable. One item passing the frame should produce one event, not one per frame.",
            "help_zh": "同一个类别连续多少帧高于置信度下限才算稳定。一件东西经过画面应当产出一条事件，而不是每帧一条。"
          },
          {
            "key": "max_fps",
            "type": "number",
            "apply": "restart",
            "title": "Inference rate limit (fps)",
            "title_zh": "推理限速（fps）",
            "default": 5,
            "min": 0.5,
            "max": 30,
            "step": 0.5,
            "help": "Upper bound on how often a captured frame is actually classified. The camera keeps supplying frames; this caps what reaches the NPU so the rest of the device keeps its CPU.",
            "help_zh": "每秒最多把多少帧真正送去分类。相机照常出帧，这一项限的是进 NPU 的部分，把 CPU 留给设备上的其它服务。"
          }
        ]
      },
      {
        "key": "mqtt",
        "title": "MQTT",
        "title_zh": "MQTT",
        "items": [
          {
            "key": "mqtt_host",
            "type": "string",
            "apply": "restart",
            "title": "Broker address",
            "title_zh": "Broker 地址",
            "default": "",
            "help": "Leave empty to watch results only on this device. This camera ships no broker of its own, so an address is what turns events into something another system can consume.",
            "help_zh": "留空就只在设备上看结果。这台相机不自带 broker，填了地址事件才会发到别的系统。"
          },
          {
            "key": "mqtt_port",
            "type": "integer",
            "apply": "restart",
            "title": "Broker port",
            "title_zh": "Broker 端口",
            "default": 1883,
            "min": 1,
            "max": 65535
          },
          {
            "key": "mqtt_topic",
            "type": "string",
            "apply": "restart",
            "title": "Result topic",
            "title_zh": "结果 topic",
            "default": "",
            "help": "Topic template; {stream_id} is substituted at publish time. Empty means waste/{stream_id}/results.",
            "help_zh": "topic 模板，发布时替换 {stream_id}。留空即 waste/{stream_id}/results。"
          },
          {
            "key": "mqtt_username",
            "type": "string",
            "apply": "restart",
            "title": "Broker username",
            "title_zh": "Broker 用户名",
            "default": ""
          },
          {
            "key": "mqtt_password",
            "type": "string",
            "apply": "restart",
            "title": "Broker password",
            "title_zh": "Broker 密码",
            "default": ""
          }
        ]
      },
      {
        "key": "runtime",
        "title": "Runtime",
        "title_zh": "运行时",
        "items": [
          {
            "key": "model_path",
            "type": "string",
            "apply": "restart",
            "title": "Model file",
            "title_zh": "模型文件",
            "help": "By default the app uses its bundled .rknn under the installed app's models/ directory. Set this only when you explicitly want a different existing model file.",
            "help_zh": "默认使用应用安装目录 models/ 下随包提供的 .rknn。只有明确要使用设备上的其他已有模型文件时才填写此项。"
          },
          {
            "key": "stream_url",
            "type": "string",
            "apply": "restart",
            "title": "Frame source",
            "title_zh": "取帧地址",
            "default": "rtsp://127.0.0.1:5554/live/1",
            "help": "RTSP substream the classifier reads, decoded by an ffmpeg subprocess. live/1 is the 640x480 substream; live/0 is 4K, which costs decode time the classifier does not need -- it works on 224x224. The device's own OpenCV has no RTSP backend and go2rtc's JPEG snapshot endpoint re-transcodes on every request (measured 5-10 s each), so neither is used here.",
            "help_zh": "分类读的 RTSP 子码流，由 ffmpeg 子进程解码。live/1 是 640x480 子码流；live/0 是 4K，解码开销对只要 224x224 的分类没有意义。设备自带的 OpenCV 没有 RTSP 后端，go2rtc 的 JPEG 快照端点每次请求都重新转码（实测 5-10 秒一次），两者都不走。"
          },
          {
            "key": "web_port",
            "type": "integer",
            "apply": "restart",
            "title": "Status port",
            "title_zh": "状态端口",
            "default": 8129,
            "min": 0,
            "max": 65535,
            "help": "Loopback-only HTTP panel: /healthz and /metrics report source, gate and publish counters, /trigger forces one classification. 0 disables it. The supervisor does not restart a crashed app, so 'the process is alive' is not the same as 'events are still going out'.",
            "help_zh": "只绑回环的 HTTP 面板：/healthz 与 /metrics 报采集、门控与发布计数，/trigger 强制分类一次。填 0 关闭。supervisor 不会自动重启崩溃的应用，所以「进程还活着」并不等于「事件还在发」。"
          }
        ]
      }
    ]
  },
  "capabilities": [
    "output"
  ],
  "health": {
    "protocol": "kit-health-v1",
    "startup_timeout_sec": 120,
    "stabilization_sec": 5,
    "liveness_interval_sec": 10,
    "liveness_failures": 3,
    "restart": {
      "policy": "on-failure",
      "max_attempts": 3,
      "window_sec": 300,
      "backoff_sec": [
        1,
        5,
        15
      ]
    }
  },
  "instances": {
    "max": 1,
    "config_scope": "app",
    "data_scope": "app",
    "endpoint_mode": "allocated"
  },
  "permissions": {
    "sdk": [
      "npu.infer",
      "result.publish"
    ],
    "filesystem": {
      "read": [
        "app",
        "appdata",
        "artifacts"
      ],
      "write": [
        "appdata",
        "tmp"
      ]
    },
    "network": {
      "listen": [],
      "outbound": [
        "configured.outputs"
      ]
    }
  },
  "resources": {
    "claims": [
      {
        "name": "npu.rknn",
        "mode": "scheduled",
        "required": true
      },
      {
        "name": "result.publish",
        "mode": "brokered",
        "required": true
      }
    ],
    "limits": {
      "memory_mb": 512,
      "cpu_percent": 300,
      "storage_mb": 128,
      "shutdown_grace_sec": 10
    }
  }
}
