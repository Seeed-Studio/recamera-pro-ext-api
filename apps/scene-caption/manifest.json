{
  "manifest_version": 2,
  "release": {
    "sequence": 8,
    "channel": "stable"
  },
  "compatibility": {
    "platform_profile": "rv1126b-linux-gnu-cp311-rknn232-v1",
    "arch": "aarch64",
    "python": "==3.11.*",
    "kit_api": ">=0.2,<1",
    "sdk_abi": ">=1.3,<2",
    "rknn_runtime": "==2.3.2"
  },
  "python": {
    "runtime_profile": "recamera-ai-cp311-v1",
    "isolation": "per-release",
    "wheels": [],
    "imports": [
      "numpy",
      "cv2"
    ]
  },
  "resources": {
    "claims": [
      {
        "name": "camera.frames",
        "mode": "shared",
        "required": true
      },
      {
        "name": "npu.rknn",
        "mode": "exclusive",
        "required": true
      },
      {
        "name": "rga",
        "mode": "shared",
        "required": true
      },
      {
        "name": "result.publish",
        "mode": "brokered",
        "required": true
      }
    ],
    "limits": {
      "memory_mb": 896,
      "cpu_percent": 300,
      "storage_mb": 8,
      "shutdown_grace_sec": 90
    }
  },
  "permissions": {
    "sdk": [
      "frame.read",
      "npu.infer",
      "rga.use",
      "result.publish"
    ],
    "filesystem": {
      "read": [
        "app",
        "artifacts",
        "appdata"
      ],
      "write": [
        "appdata",
        "tmp"
      ]
    },
    "network": {
      "listen": [],
      "outbound": [
        "configured.outputs"
      ]
    }
  },
  "health": {
    "protocol": "kit-health-v1",
    "startup_timeout_sec": 120,
    "stabilization_sec": 3,
    "liveness_interval_sec": 10,
    "liveness_failures": 3,
    "restart": {
      "policy": "on-failure",
      "max_attempts": 3,
      "window_sec": 300,
      "backoff_sec": [
        1,
        5,
        15
      ]
    }
  },
  "instances": {
    "max": 1,
    "config_scope": "app",
    "data_scope": "app",
    "endpoint_mode": "allocated"
  },
  "id": "scene-caption",
  "name": "Scene Caption",
  "name_zh": "VLM 画面描述",
  "version": "0.4.0",
  "type": "self-hosted",
  "entry": "app.py",
  "author": "reCamera",
  "description": "InternVL3-1B captions camera frames on the RV1126B. Set a prompt to choose what to describe and the language of the captions.",
  "description_zh": "InternVL3-1B 在 RV1126B 上为摄像头画面生成字幕，可通过提示词指定关注内容和字幕语言。",
  "scene": "Scene description",
  "scene_zh": "画面描述",
  "image": "/appcenter/apps/scene-caption.png",
  "icon": {
    "path": "icon.png",
    "media_type": "image/png"
  },
  "capabilities": [
    "output"
  ],
  "config_schema": {
    "groups": [
      {
        "key": "scene_analysis",
        "title": "Scene analysis",
        "title_zh": "画面分析",
        "items": [
          {
            "key": "prompt",
            "type": "string",
            "apply": "live",
            "title": "Analysis prompt",
            "title_zh": "分析提示词",
            "default": "请用一句简短的中文描述这张图片，只描述清楚可见的内容。",
            "help": "Tell the model what to look for and which language to use. The first 128 characters are used. Leave blank for the default caption.",
            "help_zh": "可指定关注的物体、回答格式和语言。使用前 128 个字符，留空使用默认描述。"
          },
          {
            "key": "interval_seconds",
            "type": "integer",
            "apply": "live",
            "title": "Pause between analyses (seconds)",
            "title_zh": "两次分析之间的等待时间（秒）",
            "default": 1,
            "help": "Time from the end of one description until the next frame is sampled. Zero samples again as soon as the model is free.",
            "help_zh": "从上一条描述完成后开始计时。设为 0 时，模型空闲后立即取新画面。",
            "min": 0,
            "max": 120,
            "step": 1
          },
          {
            "key": "stream_results",
            "type": "boolean",
            "apply": "live",
            "title": "Show text as it is generated",
            "title_zh": "逐段显示分析结果",
            "default": true,
            "help": "Display partial text on the preview. Turn off to show only completed captions. Takes effect on the next frame analyzed.",
            "help_zh": "开启时在预览中逐段显示文字，关闭时仅显示完整描述。从下一张分析画面生效。"
          },
          {
            "key": "max_new_tokens",
            "type": "integer",
            "apply": "restart",
            "title": "Maximum output tokens",
            "title_zh": "最大输出长度（token）",
            "default": 256,
            "help": "Upper limit per description. Larger values allow longer answers and may take longer. Changing this restarts the app.",
            "help_zh": "每次回答最多生成的 token 数。较大的值允许更长的回答，也可能增加耗时。修改此项会重启应用。",
            "min": 8,
            "max": 512,
            "step": 1
          }
        ]
      }
    ]
  },
  "models": [],
  "x-asset-bundle": {
    "url": "https://files.seeedstudio.com/Solution/models/vlm/scene-caption-0.4.0-models.tar.gz",
    "sha256": "1a77ab0d3c9273407eaf7f93e8af37a2bfe639cc20753edc11d5bdf42fc1c618",
    "size": 991799530
  },
  "artifacts": [
    {
      "id": "vision-0",
      "kind": "rknn",
      "source": "bundled",
      "file": "models/vision-0.rknn",
      "mount": "models/vision-0.rknn",
      "sha256": "590837a6d0347535b984e5d421a4b47772eb1bbd844501174796168b77833d3f",
      "size": 106553317,
