  "output": {
    "contract_version": 2,
    "sink": "ws",
    "schema": "events[]{kind,text,vision_ms,first_text_ms,decode_ms} + results[]{text,final} + geometry[]",
    "default_channel": [
      "ws"
    ],
    "default_mode": "raw",
    "fields": [
      {
        "name": "text",
        "from": "results[].text",
        "type": "string",
        "description": "Description of the sampled frame"
      },
      {
        "name": "final",
        "from": "results[].final",
        "type": "boolean",
        "description": "True when generation for this frame is complete"
      },
      {
        "name": "caption",
        "from": "events[kind=caption].text",
        "type": "string",
        "event_kind": "caption",
        "description": "Scene caption"
      },
      {
        "name": "geometry",
        "from": "geometry[]",
        "type": "geometry[]",
        "coord": "normalized_points",
        "description": "Caption lines on the live preview"
      }
    ],
    "default_mapping": [
      {
        "source": "events.caption | map(attribute='text') | list | last",
        "target": "text",
        "topic": "recamera/{{ app }}/caption"
      }
    ]
  },
  "render": {
    "schema_version": 1,
    "geometry": {
      "types": [
        "point"
      ],
      "style": {
        "color": "#ffffff",
        "point_radius": 1
      }
    }
  },
  "package": {
    "exclude": [
      "native"
    ]
  }
}
