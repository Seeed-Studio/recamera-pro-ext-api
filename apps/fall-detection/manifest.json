{
  "manifest_version": 2,
  "release": {"sequence": 3, "channel": "stable"},
  "compatibility": {
    "platform_profile": "rv1126b-linux-gnu-cp311-rknn232-v1",
    "arch": "aarch64", "python": "==3.11.*",
    "kit_api": ">=0.1,<1", "sdk_abi": ">=1.3,<2", "rknn_runtime": "==2.3.2"
  },
  "python": {"runtime_profile": "recamera-ai-cp311-v1", "isolation": "per-release", "wheels": [], "imports": []},
  "artifacts": [
    {
      "id": "pose-model", "kind": "rknn", "source": "bundled",
      "file": "models/yolo11n_pose_rawhead_int8.rknn",
      "sha256": "3629dd1fe6c2229276295ff1050cf4a2cef9892bc87e4d2b50f5bef15bcc8add",
      "size": 4691086, "mount": "models/yolo11n_pose_rawhead_int8.rknn",
      "required": true, "share_scope": "content"
    },
    {
      "id": "temporal-recamera", "kind": "data", "source": "bundled",
      "file": "models/temporal_recamera_pro_rknn_v1.json.gz",
      "sha256": "4473e2af0fe5e47b03306bf9a866103a21dbdfceb794933034173bed53de6826",
      "size": 85038, "mount": "models/temporal_recamera_pro_rknn_v1.json.gz",
      "required": true, "share_scope": "content"
    },
    {
      "id": "temporal-yolo11s", "kind": "data", "source": "bundled",
      "file": "models/temporal_yolo11s_pose_v1.json.gz",
      "sha256": "36545c5b5de501a07d3d46e626c8827d6f23e155c2420d5e4206bac7e555d74d",
      "size": 95570, "mount": "models/temporal_yolo11s_pose_v1.json.gz",
      "required": false, "share_scope": "content"
    }
  ],
  "resources": {
    "claims": [
      {"name": "camera.frames", "mode": "shared", "required": true},
      {"name": "npu.rknn", "mode": "scheduled", "required": true},
      {"name": "rga", "mode": "shared", "required": true},
      {"name": "result.publish", "mode": "brokered", "required": true}
    ],
    "limits": {"memory_mb": 384, "cpu_percent": 300, "storage_mb": 32, "shutdown_grace_sec": 10}
  },
  "permissions": {
    "sdk": ["frame.read", "npu.infer", "rga.use", "result.publish"],
    "filesystem": {"read": ["app", "artifacts"], "write": ["appdata", "tmp"]},
    "network": {"listen": [], "outbound": ["configured.outputs"]}
  },
  "health": {
    "protocol": "kit-health-v1", "startup_timeout_sec": 120,
    "stabilization_sec": 3, "liveness_interval_sec": 10, "liveness_failures": 3,
    "restart": {"policy": "on-failure", "max_attempts": 3, "window_sec": 300, "backoff_sec": [1, 5, 15]}
  },
  "instances": {"max": 1, "config_scope": "app", "data_scope": "app", "endpoint_mode": "allocated"},
  "id": "fall-detection",
  "name": "Fall Detection",
  "name_zh": "跌倒检测",
  "version": "0.2.1",
  "image": "/appcenter/apps/fall-detection.png",
  "type": "self-hosted",
  "scene": "Safety & Care",
  "scene_zh": "安全看护",
  "description": "On-device multi-person fall detection using YOLO11n-Pose, geometric candidate arming, and a frozen 48-frame learned temporal confirmation gate. Each person receives a stable track_id, independent history, and independent fall state.",
  "description_zh": "使用 YOLO11n-Pose、几何候选触发与冻结的 48 帧学习型时序确认门在设备本地检测多人跌倒。每个人都有稳定的 track_id、独立历史和独立跌倒状态。",
  "author": "Seeed reCamera Pro",
  "entry": "app.py",
  "package": {
    "exclude": ["evaluation", "tools", "test_*.py", "*.md"]
  },
  "capabilities": [
    "output"
  ],
  "models": [
    {
      "id": "yolo11n_pose_rawhead_int8",
      "file": "models/yolo11n_pose_rawhead_int8.rknn",
      "task": "pose",
      "input": [
        1,
        640,
        640,
        3
      ],
      "quant": "int8",
      "keypoints": "coco17"
    }
  ],
  "x-default_model": "yolo11n_pose_rawhead_int8",
  "x-temporal_profile": {
    "id": "jetson-yolo11s-pose-optimized-v1",
    "file": "models/temporal_yolo11s_pose_v1.json.gz",
    "provenance": "transfer-fallback-not-recamera-pro-native",
    "window_frames": 48,
    "sample_fps": 15,
    "stride_frames": 3,
    "threshold": 0.8,
    "consecutive": 3,
    "runtime": "numpy"
  },
  "postproc": "pose",
  "render": {
    "schema_version": 1,
    "boxes": {"color_by": "state", "label": "state", "line_width": 2},
    "keypoints": {
      "layout": "coco17",
      "point_radius": 3,
      "line_width": 2,
      "conf_min": 0.3
    },
    "events": {
      "fall": {"as": "toast", "position": "top-center", "duration_sec": 4, "text": "Fall #{{ track_id }}"}
    },
    "stream_osd": {"supported": ["boxes"], "default": false}
  },
  "output": {
    "contract_version": 2,
    "sink": "ws",
    "schema": "results[]{box,score,keypoints[17][x,y,conf],kind,track_id,state,fall_detected,event_id} + events[]{kind=pose_state|fall,track_id,state,fall_detected,event_id,...}",
    "default_channel": [
      "ws"
    ],
    "default_mode": "raw",
    "fields": [
      {"name": "box", "from": "results[].box", "type": "bbox<float>[4]", "coord": "pixel_xyxy", "description": "Person box, original-frame xyxy pixels"},
      {"name": "score", "from": "results[].score", "type": "float", "description": "Person detection confidence"},
      {"name": "keypoints", "from": "results[].keypoints", "type": "keypoints<float>[17]", "coord": "pixel_points", "description": "COCO-17 pose keypoints"},
      {"name": "kind", "from": "results[].kind", "type": "string", "description": "Result kind, always 'person'"},
      {"name": "track_id", "from": "results[].track_id", "type": "integer", "description": "Stable per-identity track id"},
      {"name": "state", "from": "results[].state", "type": "string", "description": "Per-identity fall state"},
      {"name": "fall_detected", "from": "results[].fall_detected", "type": "bool", "description": "Fall confirmed for this identity"},
      {"name": "event_id", "from": "results[].event_id", "type": "integer", "description": "Fall event id for this identity"},
      {"name": "person_detected", "from": "results[].person_detected", "type": "bool", "description": "Person present flag"},
      {"name": "person_score", "from": "results[].person_score", "type": "float", "description": "Person score augmentation"},
      {"name": "tracking", "from": "results[].tracking", "type": "bool", "description": "Tracking active flag"},
      {"name": "missed_frames", "from": "results[].missed_frames", "type": "integer", "description": "Consecutive missed frames for the track"},
      {"name": "features", "from": "results[].features", "type": "object", "description": "Nested geometric fall features/diagnostics"},
      {"name": "pose_state_kind", "from": "events[kind=pose_state].kind", "type": "string", "event_kind": "pose_state", "description": "Event kind, always 'pose_state'"},
      {"name": "pose_state_track_id", "from": "events[kind=pose_state].track_id", "type": "integer", "event_kind": "pose_state", "description": "Track id of the pose_state event"},
      {"name": "pose_state_state", "from": "events[kind=pose_state].state", "type": "string", "event_kind": "pose_state", "description": "State of the pose_state event"},
      {"name": "pose_state_fall_detected", "from": "events[kind=pose_state].fall_detected", "type": "bool", "event_kind": "pose_state", "description": "Fall flag of the pose_state event"},
      {"name": "pose_state_event_id", "from": "events[kind=pose_state].event_id", "type": "integer", "event_kind": "pose_state", "description": "Fall event id of the pose_state event"},
      {"name": "fall_kind", "from": "events[kind=fall].kind", "type": "string", "event_kind": "fall", "description": "Confirmed fall edge event"},
      {"name": "fall_track_id", "from": "events[kind=fall].track_id", "type": "integer", "event_kind": "fall", "description": "Track id of the fall edge"},
      {"name": "fall_event_id", "from": "events[kind=fall].event_id", "type": "integer", "event_kind": "fall", "description": "Fall event id of the fall edge"},
      {"name": "fall_state", "from": "events[kind=fall].state", "type": "string", "event_kind": "fall", "description": "State at the fall edge"}
    ],
    "default_mapping": [
      {"source": "results | length", "target": "person_count", "topic": "recamera/{{ app }}/summary", "task": "keypoint"},
      {"source": "results | selectattr('fall_detected') | list | length", "target": "fallen_count", "topic": "recamera/{{ app }}/summary", "task": "keypoint"},
      {"source": "events.fall | last", "target": "fall_event", "topic": "recamera/{{ app }}/fall", "task": "keypoint"}
    ]
  },
  "config_schema": {
    "groups": [
      {
        "key": "detection",
        "title": "Detection thresholds",
        "title_zh": "检测阈值",
        "items": [
          {
            "key": "temporal_confirmation_required",
            "type": "boolean",
            "apply": "live",
            "title": "Require learned confirmation",
            "title_zh": "必须通过学习型时序确认",
            "default": true
          },
          {
            "key": "confidence",
            "type": "number",
            "apply": "live",
            "title": "Person confidence",
            "title_zh": "人体置信度",
            "min": 0.05,
            "max": 0.95,
            "step": 0.05,
            "default": 0.4
          },
          {
            "key": "keypoint_confidence",
            "type": "number",
            "apply": "live",
            "title": "Keypoint confidence",
            "title_zh": "关键点置信度",
            "min": 0.05,
            "max": 0.95,
            "step": 0.05,
            "default": 0.5
          },
          {
            "key": "hip_drop_speed_threshold",
            "type": "number",
            "apply": "live",
            "title": "Hip drop speed",
            "title_zh": "髋部下坠速度",
            "min": 0.0,
            "max": 2.0,
            "step": 0.05,
            "default": 0.25
          },
          {
            "key": "hip_drop_distance_threshold",
            "type": "number",
            "apply": "live",
            "title": "Minimum hip drop distance",
            "title_zh": "最小髋部下坠距离",
            "min": 0,
            "max": 0.5,
            "step": 0.005,
            "default": 0.02
          },
          {
            "key": "motion_window_sec",
            "type": "number",
            "apply": "live",
            "title": "Drop-to-posture window (s)",
            "title_zh": "下坠到转横窗口（秒）",
            "min": 0,
            "max": 5,
            "step": 0.1,
            "default": 0.75
          },
          {
            "key": "torso_angle_threshold_deg",
            "type": "number",
            "apply": "live",
            "title": "Lying torso angle (deg)",
            "title_zh": "躺卧躯干角度（度）",
            "min": 20,
            "max": 89,
            "step": 1,
            "default": 55
          },
          {
            "key": "bbox_aspect_ratio_threshold",
            "type": "number",
            "apply": "live",
            "title": "Lying box aspect ratio",
            "title_zh": "躺卧框宽高比",
            "min": 1.0,
            "max": 4.0,
            "step": 0.05,
            "default": 1.25
          },
          {
            "key": "min_suspected_features",
            "type": "integer",
            "apply": "live",
            "title": "Minimum evidence features",
            "title_zh": "最少证据特征数",
            "min": 1,
            "max": 3,
            "step": 1,
            "default": 2
          }
        ]
      },
      {
        "key": "timing",
        "title": "Temporal confirmation",
        "title_zh": "时序确认",
        "items": [
          {
            "key": "confirmation_sec",
            "type": "number",
            "apply": "live",
            "title": "Confirmation window (s)",
            "title_zh": "确认窗口（秒）",
            "min": 0,
            "max": 10,
            "step": 0.1,
            "default": 0.8
          },
          {
            "key": "suspected_timeout_sec",
            "type": "number",
            "apply": "live",
            "title": "Suspected timeout (s)",
            "title_zh": "疑似超时（秒）",
            "min": 0.1,
            "max": 30,
            "step": 0.1,
            "default": 1.5
          },
          {
            "key": "occlusion_grace_sec",
            "type": "number",
            "apply": "live",
            "title": "Post-impact occlusion grace (s)",
            "title_zh": "落地后遮挡宽限（秒）",
            "min": 0,
            "max": 5,
            "step": 0.1,
            "default": 0.75
          },
          {
            "key": "recovery_torso_angle_deg",
            "type": "number",
            "apply": "live",
            "title": "Upright torso angle (deg)",
            "title_zh": "站立躯干角度（度）",
            "min": 5,
            "max": 89,
            "step": 1,
            "default": 35
          },
          {
            "key": "recovery_aspect_ratio",
            "type": "number",
            "apply": "live",
            "title": "Upright box aspect ratio",
            "title_zh": "站立框宽高比",
            "min": 1.0,
            "max": 3.0,
            "step": 0.05,
            "default": 1.1
          },
          {
            "key": "recovery_window_sec",
            "type": "number",
            "apply": "live",
            "title": "Recovery window (s)",
            "title_zh": "恢复窗口（秒）",
            "min": 0,
            "max": 30,
            "step": 0.1,
            "default": 2.0
          },
          {
            "key": "cooldown_sec",
            "type": "number",
            "apply": "live",
            "title": "Alarm cooldown (s)",
            "title_zh": "报警冷却（秒）",
            "min": 0,
            "max": 60,
            "step": 0.5,
            "default": 3.0
          }
        ]
      }
    ]
  },
  "ha_entities": [
    {
      "component": "binary_sensor",
      "object_id": "fall_detected",
      "name": "Fall Detected",
      "value_template": "{{ 'ON' if value_json.fallen_count | default(0) > 0 else 'OFF' }}",
      "device_class": "problem"
    },
    {
      "component": "sensor",
      "object_id": "fall_state",
      "name": "Fall State",
      "value_template": "{{ value_json.summary.state | default('') }}",
      "icon": "mdi:human-handsdown"
    },
    {
      "component": "sensor",
      "object_id": "fall_event_id",
      "name": "Fall Event ID",
      "value_template": "{{ value_json.summary.event_id | default(0) }}"
    },
    {
      "component": "sensor",
      "object_id": "person_count",
      "name": "Person Count",
      "value_template": "{{ value_json.person_count | default(0) }}",
      "state_class": "measurement",
      "icon": "mdi:account-multiple"
    },
    {
      "component": "sensor",
      "object_id": "fallen_count",
      "name": "Fallen Count",
      "value_template": "{{ value_json.fallen_count | default(0) }}",
      "state_class": "measurement",
      "icon": "mdi:account-alert"
    },
    {
      "component": "binary_sensor",
      "object_id": "person_present",
      "name": "Person Present",
      "value_template": "{{ 'ON' if value_json.person_count | default(0) > 0 else 'OFF' }}",
      "device_class": "occupancy"
    }
  ]
}
