{
  "manifest_version": 2,
  "compatibility": {
    "platform_profile": "rv1126b-linux-gnu-cp311-rknn232-v1",
    "arch": "aarch64",
    "python": "==3.11.*",
    "kit_api": ">=0.1,<1",
    "sdk_abi": ">=1.3,<2",
    "rknn_runtime": "==2.3.2"
  },
  "python": {
    "runtime_profile": "recamera-ai-cp311-v1",
    "isolation": "per-release",
    "wheels": [],
    "imports": []
  },
  "resources": {
    "claims": [
      {
        "name": "camera.frames",
        "mode": "shared",
        "required": true
      },
      {
        "name": "npu.rknn",
        "mode": "scheduled",
        "required": true
      },
      {
        "name": "rga",
        "mode": "shared",
        "required": true
      },
      {
        "name": "result.publish",
        "mode": "brokered",
        "required": true
      }
    ],
    "limits": {
      "memory_mb": 256,
      "cpu_percent": 300,
      "storage_mb": 64,
      "shutdown_grace_sec": 15
    }
  },
  "permissions": {
    "sdk": [
      "frame.read",
      "npu.infer",
      "rga.use",
      "result.publish"
    ],
    "filesystem": {
      "read": [
        "app",
        "appdata",
        "artifacts"
      ],
      "write": [
        "appdata",
        "tmp"
      ]
    },
    "network": {
      "listen": [],
      "outbound": [
        "configured.outputs"
      ]
    }
  },
  "health": {
    "protocol": "kit-health-v1",
    "startup_timeout_sec": 120,
    "stabilization_sec": 3,
    "liveness_interval_sec": 10,
    "liveness_failures": 3,
    "restart": {
      "policy": "on-failure",
      "max_attempts": 3,
      "window_sec": 300,
      "backoff_sec": [
        1,
        5,
        15
      ]
    }
  },
  "instances": {
    "max": 1,
    "config_scope": "app",
    "data_scope": "app",
    "endpoint_mode": "allocated"
  },
  "id": "cvsprout-inference",
  "name": "CVSprout Inference",
  "name_zh": "CVSprout 模型推理",
  "version": "1.0.0",
  "release": {
    "sequence": 1,
    "channel": "stable"
  },
  "type": "self-hosted",
  "author": "CVSprout contributors",
  "entry": "app.py",
  "image": "/appcenter/apps/cvsprout-inference.png",
  "icon": {
    "path": "icon.png",
    "media_type": "image/png"
  },
  "description": "Run detection models trained and converted by CVSprout on reCamera Pro, with original-image bounding boxes and model version tracking.",
  "description_zh": "运行 CVSprout 训练并转换的 RV1126B 检测模型，发布原图坐标检测框与模型版本。",
  "scene": "Custom model detection",
  "scene_zh": "自定义模型检测",
  "capabilities": [
    "output"
  ],
  "postproc": "detect",
  "artifacts": [
    {
      "id": "detector",
      "kind": "rknn",
      "source": "bundled",
      "file": "models/model.rknn",
      "mount": "models/model.rknn",
      "sha256": "26f251e28320192f4a781aa33565ed6264567d108c1a77b667cdc98f54fb97be",
      "size": 4860688,
      "required": true,
      "share_scope": "content"
    }
  ],
  "models": [
    {
      "id": "detector",
      "file": "models/model.rknn",
      "task": "detect",
      "input": [
        1,
        640,
        640,
        3
      ],
      "quant": "int8",
      "classes": [
        "person"
      ]
    }
  ],
  "render": {
    "schema_version": 1,
    "boxes": {
      "color_by": "cls_name",
      "label": "cls_name",
      "line_width": 2
    },
    "stream_osd": {
      "supported": [
        "boxes"
      ],
      "default": false
    }
  },
  "config_schema": {
    "groups": [
      {
        "key": "detection",
        "title": "Detection",
        "title_zh": "检测",
        "items": [
          {
            "key": "conf",
            "type": "number",
            "apply": "live",
            "title": "Confidence threshold",
            "title_zh": "置信度阈值",
            "default": 0.35,
            "min": 0.05,
            "max": 0.95,
            "step": 0.05
          },
          {
            "key": "iou",
            "type": "number",
            "apply": "live",
            "title": "NMS IoU threshold",
            "title_zh": "NMS IoU 阈值",
            "default": 0.45,
            "min": 0.1,
            "max": 0.9,
            "step": 0.05
          }
        ]
      }
    ]
  },
  "output": {
    "contract_version": 2,
    "sink": "ws",
    "schema": "results[]{box,cls,cls_name,score} + model_release",
    "default_channel": [
      "ws"
    ],
    "default_mode": "raw",
    "fields": [
      {
        "name": "box",
        "from": "results[].box",
        "type": "bbox<float>[4]",
        "coord": "pixel_xyxy",
        "description": "Original-frame xyxy detection box"
      },
      {
        "name": "cls",
        "from": "results[].cls",
        "type": "integer",
        "description": "Class index in the bundled label table"
      },
      {
        "name": "cls_name",
        "from": "results[].cls_name",
        "type": "string",
        "description": "Bundled model class label"
      },
      {
        "name": "score",
        "from": "results[].score",
        "type": "float",
        "description": "Detection confidence"
      },
      {
        "name": "model_release",
        "from": "model_release",
        "type": "string",
        "description": "CVSprout model release identifier"
      }
    ],
    "default_mapping": [
      {
        "source": "detection.entries",
        "target": "detections",
        "topic": "recamera/{{ app }}/detections",
        "task": "detection"
      }
    ]
  }
}
