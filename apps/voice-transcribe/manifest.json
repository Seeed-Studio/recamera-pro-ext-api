  "resources": {
    "profiles": [
      {
        "when": {
          "asr_backend": "rk"
        },
        "claims": [
          {
            "name": "audio.capture",
            "mode": "shared",
            "required": true
          },
          {
            "name": "npu.rknn",
            "mode": "scheduled",
            "required": true
          },
          {
            "name": "result.publish",
            "mode": "brokered",
            "required": true
          }
        ]
      },
      {
        "when": {
          "asr_backend": "sherpa"
        },
        "claims": [
          {
            "name": "audio.capture",
            "mode": "shared",
            "required": true
          },
          {
            "name": "result.publish",
            "mode": "brokered",
            "required": true
          }
        ]
      }
    ],
    "limits": {
      "memory_mb": 768,
      "cpu_percent": 400,
      "storage_mb": 256,
      "shutdown_grace_sec": 15
    }
  },
  "permissions": {
    "sdk": [
      "audio.read",
      "npu.infer",
      "result.publish"
    ],
    "filesystem": {
      "read": [
        "app",
        "appdata",
        "artifacts"
      ],
      "write": [
        "appdata",
        "tmp"
      ]
    },
    "network": {
      "listen": [],
      "outbound": [
        "configured.outputs",
        "rkipc.rtsp"
      ]
    }
  },
  "health": {
    "protocol": "kit-health-v1",
    "startup_timeout_sec": 180,
    "stabilization_sec": 5,
    "liveness_interval_sec": 10,
    "liveness_failures": 3,
    "restart": {
      "policy": "on-failure",
      "max_attempts": 2,
      "window_sec": 300,
      "backoff_sec": [
        2,
        10
      ]
    }
  },
  "instances": {
    "max": 1,
    "config_scope": "app",
    "data_scope": "app",
    "endpoint_mode": "allocated"
  },
  "id": "voice-transcribe",
  "name": "Voice Transcribe",
  "name_zh": "语音转录",
  "version": "0.1.3",
  "image": "/appcenter/apps/voice-transcribe.png",
  "icon": {
    "path": "icon.png",
    "media_type": "image/png"
  },
  "type": "self-hosted",
  "scene": "Voice & Audio",
  "scene_zh": "语音音频",
  "description": "On-device offline voice transcription: wake word -> VAD endpointing -> SenseVoice ASR. Captures the mic via the official ALSA `ai_asr` shared-capture PCM (dsnoop -- shares the mic with rkipc, no takeover, video untouched; RTSP audio-track demux is a fallback). Streaming sherpa-onnx KWS and silero VAD run on the ARM cores; the default `rk` ASR backend runs SenseVoice w4a16 on the RV1126B NPU under the shared rkipc broker lease. The optional `sherpa` ASR backend is CPU-only and requires an extra ONNX model. Streams state and transcript text to the /appcenter panel.",
  "description_zh": "设备端离线语音转录：唤醒词 -> VAD 断句 -> SenseVoice 识别。默认通过官方 ALSA `ai_asr` 共享采集 PCM（dsnoop，与 rkipc 共用麦克风、不接管设备、不影响视频；也可回退到 RTSP 音频轨）。流式 sherpa-onnx KWS 与 silero VAD 运行在 ARM 核心；默认 `rk` 识别后端通过共享的 rkipc broker 租约，在 RV1126B NPU 上运行 SenseVoice w4a16。可选 `sherpa` 识别后端仅使用 CPU，且需额外提供 ONNX 模型。向 /appcenter 面板输出状态与转录文本。",
  "author": "Seeed reCamera Pro",
  "entry": "app.py",
  "capabilities": [
    "audio",
    "output"
  ],
  "needs_model": false,
  "models": [],
  "postproc": "voice",
  "tags": [
    "voice",
    "asr",
    "audio",
    "npu"
  ],
  "render": {
    "schema_version": 1,
    "events": {
      "transcript": {
        "as": "subtitle",
        "position": "bottom",
        "max_lines": 2,
        "duration_sec": 4,
        "text": "{{ text }}"
      },
      "state": {
        "as": "none"
      }
    }
  },
  "output": {
    "contract_version": 2,
    "sink": "ws",
    "schema": "events[]{kind=state|wake|transcript|listen_timeout, state, text, keyword, backend, audio_sec, rtf, language} + top-level {state, summary{state,text}}",
    "default_channel": [
      "ws"
    ],
    "default_mode": "raw",
    "persistent_summary": true,
    "fields": [
      {
        "name": "state",
        "from": "state",
        "type": "string",
        "description": "Persistent top-level voice state (idle/listening/transcribing)"
      },
      {
        "name": "summary_state",
        "from": "summary.state",
        "type": "string",
        "description": "Persistent summary state, mirrors top-level state"
      },
      {
        "name": "summary_text",
        "from": "summary.text",
        "type": "string",
        "description": "Persistent last transcript text (survives non-transcript events)"
      },
      {
        "name": "event_kind",
        "from": "events[].kind",
        "type": "string",
        "description": "Event kind (state/wake/transcript/listen_timeout)"
      },
      {
        "name": "event_type",
        "from": "events[].type",
        "type": "string",
        "description": "Original state-machine event type (mirrored into kind)"
      },
      {
        "name": "event_t",
        "from": "events[].t",
        "type": "float",
        "description": "Monotonic event timestamp"
      },
      {
        "name": "event_state",
        "from": "events[].state",
        "type": "string",
        "event_kind": "state",
        "optional": true,
        "description": "State for state events"
      },
      {
        "name": "event_utterance_sec",
        "from": "events[].utterance_sec",
        "type": "float",
        "optional": true,
        "description": "Utterance duration"
      },
      {
        "name": "event_keyword",
        "from": "events[].keyword",
        "type": "string",
        "optional": true,
        "description": "Wake keyword (wake events)"
      },
      {
        "name": "event_backend",
        "from": "events[].backend",
        "type": "string",
        "optional": true,
        "description": "Wake backend (wake events)"
      },
      {
        "name": "event_score",
        "from": "events[].score",
        "type": "float",
        "optional": true,
        "description": "Wake score (wake events)"
      },
      {
        "name": "event_transcript",
        "from": "events[].transcript",
        "type": "string",
        "optional": true,
        "description": "Transcript text (transcript events)"
      },
      {
        "name": "event_text",
        "from": "events[].text",
        "type": "string",
        "event_kind": "transcript",
        "optional": true,
        "description": "Transcript text alias"
      },
      {
        "name": "event_audio_sec",
        "from": "events[].audio_sec",
        "type": "float",
        "optional": true,
        "description": "Transcribed audio duration"
      },
      {
        "name": "event_rtf",
        "from": "events[].rtf",
        "type": "float",
        "optional": true,
        "description": "Real-time factor of transcription"
      },
      {
        "name": "event_language",
        "from": "events[].language",
        "type": "string",
        "optional": true,
        "description": "Detected/selected language"
      }
    ],
    "default_mapping": [
      {
        "source": "(events.state | last).state",
        "target": "state",
        "topic": "recamera/{{ app }}/state",
        "task": "detection"
      },
      {
        "source": "(events.transcript | last).text",
        "target": "transcript",
        "topic": "recamera/{{ app }}/transcript",
        "task": "detection"
      },
      {
        "source": "(events.wake | last).keyword",
        "target": "wake",
        "topic": "recamera/{{ app }}/wake",
        "task": "detection"
      }
    ]
  },
  "config_schema": {
    "groups": [
      {
        "key": "wake",
        "title": "Wake word",
        "title_zh": "唤醒词",
        "items": [
          {
            "key": "wake_backend",
            "type": "enum",
            "apply": "restart",
            "title": "Wake backend",
            "title_zh": "唤醒后端",
            "options": [
              "kws",
              "asr"
            ],
            "option_labels": [
              "Streaming KWS (fast)",
              "ASR keyword match"
            ],
            "default": "kws"
          },
          {
            "key": "wakeword",
            "type": "string",
            "apply": "restart",
            "title": "Wake phrase (ASR backend)",
            "title_zh": "唤醒短语（ASR 后端）",
            "default": "hello camera"
          },
          {
            "key": "kws_threshold",
            "type": "number",
            "apply": "restart",
            "title": "KWS trigger threshold",
            "title_zh": "KWS 触发阈值",
            "min": 0.05,
            "max": 0.9,
            "step": 0.05,
            "default": 0.25
          },
          {
            "key": "kws_score",
            "type": "number",
            "apply": "restart",
            "title": "KWS boost score",
            "title_zh": "KWS 加权分数",
            "min": 0.5,
            "max": 4.0,
            "step": 0.1,
            "default": 1.5
          }
        ]
      },
      {
        "key": "capture",
        "title": "Capture & endpointing",
        "title_zh": "采集与断句",
        "items": [
          {
            "key": "asr_backend",
            "type": "enum",
            "apply": "restart",
            "title": "ASR backend",
            "title_zh": "识别后端",
            "options": [
              "rk",
              "sherpa"
            ],
            "option_labels": [
              "NPU w4a16 (rk)",
              "CPU sherpa"
            ],
            "default": "rk",
            "help": "rk = NPU w4a16 SenseVoice (uses the authenticated model bundled with this app release). sherpa = CPU SenseVoice (needs model.int8.onnx, not shipped).",
            "help_zh": "rk = NPU w4a16 SenseVoice（使用本应用版本随包认证的模型）。sherpa = CPU SenseVoice（需 model.int8.onnx，未随包提供）。"
          },
          {
            "key": "language",
            "type": "enum",
            "apply": "restart",
            "title": "Language",
            "title_zh": "语言",
            "options": [
              "auto",
              "zh",
              "en",
              "ja",
              "ko",
              "yue"
            ],
            "option_labels": [
              "Auto",
              "Chinese",
              "English",
              "Japanese",
              "Korean",
              "Cantonese"
            ],
            "default": "auto"
          },
          {
            "key": "min_silence_sec",
            "type": "number",
            "apply": "restart",
            "title": "Silence to end utterance (s)",
            "title_zh": "断句静音时长（秒）",
            "min": 0.2,
            "max": 3.0,
            "step": 0.1,
            "default": 0.6
          },
          {
            "key": "max_utterance_sec",
            "type": "number",
            "apply": "restart",
            "title": "Max recording length (s)",
            "title_zh": "最长录音时长（秒）",
            "min": 2.0,
            "max": 30.0,
            "step": 1.0,
            "default": 15.0
          },
          {
            "key": "preroll_ms",
            "type": "number",
            "apply": "restart",
            "title": "Pre-roll look-back (ms)",
            "title_zh": "句头回看补偿（毫秒）",
            "min": 0.0,
            "max": 800.0,
            "step": 50.0,
            "default": 300.0
          },
          {
            "key": "listen_timeout_sec",
            "type": "number",
            "apply": "restart",
            "title": "Listen timeout after wake (s)",
            "title_zh": "唤醒后聆听超时（秒）",
            "min": 2.0,
            "max": 20.0,
            "step": 1.0,
            "default": 8.0
          },
          {
            "key": "model_dir",
            "type": "string",
            "apply": "restart",
            "title": "Model asset directory",
            "title_zh": "模型资源目录",
            "default": "models/asr",
            "help": "Managed manifest-v2 RK inference authorizes only this package-relative bundled directory. A custom/shared directory is supported only for standalone or legacy launches.",
            "help_zh": "由应用中心管理的 manifest v2 RK 推理只授权此包内相对目录；自定义或共享目录仅用于独立运行或旧版兼容。"
          },
          {
            "key": "audio_source",
            "type": "enum",
            "apply": "restart",
            "title": "Audio source",
            "title_zh": "音频来源",
            "options": [
              "ai_asr",
              "rtsp"
            ],
            "default": "ai_asr",
            "help": "ai_asr = official ALSA shared-capture PCM (clean, no rkipc transcode; needs root/audio group). rtsp = demux rkipc RTSP audio track (fallback).",
            "help_zh": "ai_asr = 官方 ALSA 共享采集 PCM（干净、不经 rkipc 转码；需 root/audio 组）。rtsp = 解复用 rkipc RTSP 音频轨（备用）。"
          },
          {
            "key": "audio_filter",
            "type": "string",
            "apply": "restart",
            "title": "Mic gain filter (ffmpeg -af)",
            "title_zh": "麦克风增益滤镜（ffmpeg -af）",
            "default": "loudnorm=I=-16:TP=-1.5"
          }
        ]
      }
    ]
  },
  "ha_entities": [
    {
      "component": "sensor",
      "object_id": "voice_state",
      "name": "Voice State",
      "value_template": "{{ value_json.summary.state | default('idle') }}",
      "icon": "mdi:microphone"
    },
    {
      "component": "sensor",
      "object_id": "last_transcript",
      "name": "Last Transcript",
      "value_template": "{{ value_json.summary.text | default('') }}",
      "icon": "mdi:message-text"
    }
  ]
}