{
  "manifest_version": 2,
  "release": {"sequence": 4, "channel": "stable"},
  "compatibility": {"platform_profile": "rv1126b-linux-gnu-cp311-rknn232-v1", "arch": "aarch64", "python": "==3.11.*", "kit_api": ">=0.1,<1", "sdk_abi": ">=1.3,<2", "rknn_runtime": "==2.3.2"},
  "python": {"runtime_profile": "recamera-ai-cp311-v1", "isolation": "per-release", "wheels": [], "imports": []},
  "artifacts": [
    {"id": "ocr-detector", "kind": "rknn", "source": "bundled", "file": "models/ppocr_det_fp16.rknn", "sha256": "c18ec85219ebbe6d926a28007c06d5c2d3ab5c0036ddfb1f2b79a90a6360ecef", "size": 2103164, "mount": "models/ppocr_det_fp16.rknn", "required": true, "share_scope": "content"},
    {"id": "ocr-recognizer", "kind": "rknn", "source": "bundled", "file": "models/ppocr_rec_fp16.rknn", "sha256": "0ffcd71dd350bcad8e57809f7ee1d072527dbef0d8793dc26c57add22716d87c", "size": 6758713, "mount": "models/ppocr_rec_fp16.rknn", "required": true, "share_scope": "content"},
    {"id": "ocr-dictionary", "kind": "dictionary", "source": "bundled", "file": "models/ppocr_keys_v1.txt", "sha256": "28b2362ad4ab2dc38769aa72feb535e3a9ddb3fd2a7585a05920e6393b1dc7f7", "size": 26249, "mount": "models/ppocr_keys_v1.txt", "required": true, "share_scope": "content"}
  ],
  "resources": {"claims": [
    {"name": "camera.frames", "mode": "shared", "required": true},
    {"name": "npu.rknn", "mode": "scheduled", "required": true},
    {"name": "rga", "mode": "shared", "required": true},
    {"name": "result.publish", "mode": "brokered", "required": true}
  ], "limits": {"memory_mb": 384, "cpu_percent": 300, "storage_mb": 32, "shutdown_grace_sec": 10}},
  "permissions": {"sdk": ["frame.read", "npu.infer", "rga.use", "result.publish"], "filesystem": {"read": ["app", "artifacts"], "write": ["appdata", "tmp"]}, "network": {"listen": [], "outbound": ["configured.outputs"]}},
  "health": {"protocol": "kit-health-v1", "startup_timeout_sec": 120, "stabilization_sec": 3, "liveness_interval_sec": 10, "liveness_failures": 3, "restart": {"policy": "on-failure", "max_attempts": 3, "window_sec": 300, "backoff_sec": [1, 5, 15]}},
  "instances": {"max": 1, "config_scope": "app", "data_scope": "app", "endpoint_mode": "allocated"},
  "id": "ppocr-reader",
  "name": "PP-OCR Reader",
  "name_zh": "文字识别",
  "version": "0.1.3",
  "image": "/appcenter/apps/ppocr-reader.png",
  "icon": {"path": "icon.png", "media_type": "image/png"},
  "type": "self-hosted",
  "scene": "OCR & Text",
  "scene_zh": "文字识别",
  "description": "On-device OCR text reader: a DBNet detector (PP-OCRv3, 480x480) finds every text region, each region is perspective-cropped to an upright 48x320 strip, then a CTC recognizer (SVTR-LCNet, 6625-class Chinese+English dictionary) reads the characters. Emits one event per text box with the recognized string, its quad and confidence. Everything runs on-device; no image or text leaves the camera. Port of the first-gen SSCMA ppocr-reader C++ solution to the reCamera Pro Python kit.",
  "description_zh": "设备端 OCR 文字识别：DBNet 检测器（PP-OCRv3，480x480）找出每个文本区域，逐区域透视裁剪为竖直的 48x320 文本条，再由 CTC 识别器（SVTR-LCNet，6625 类中英文字典）解码字符。每个文本框输出一条事件，包含识别文本、四点框与置信度。全流程设备端运行，图像与文本均不出设备。一代 SSCMA ppocr-reader C++ 方案到 reCamera Pro Python kit 的移植。",
  "author": "Seeed reCamera Pro",
  "entry": "app.py",
  "capabilities": [
    "output"
  ],
  "record_trigger": {
    "version": 1,
    "signals": [
      {"id": "text", "type": "detection", "classes": ["text"], "supports_roi": true}
    ]
  },
  "models": [
    {
      "id": "ppocr_det_fp16",
      "file": "models/ppocr_det_fp16.rknn",
      "task": "detect",
      "input": [
        1,
        480,
        480,
        3
      ],
      "quant": "fp16",
      "norm": "imagenet-baked",
      "output": "db-probmap-1x1x480x480",
      "role": "stage1_det"
    },
    {
      "id": "ppocr_rec_fp16",
      "file": "models/ppocr_rec_fp16.rknn",
      "task": "recognize",
      "input": [
        1,
        48,
        320,
        3
      ],
      "quant": "fp16",
      "norm": "minusone-to-one-baked",
      "output": "ctc-logits-1x40x6625",
      "dict": "models/ppocr_keys_v1.txt",
      "role": "stage2_rec"
    }
  ],
  "x-default_model": "ppocr_det_fp16",
  "postproc": "db_ocr",
  "render": {
    "schema_version": 1,
    "quads": {"points": "quad", "label": "text", "line_width": 2},
    "events": {
      "text": {
        "as": "badge",
        "text": "{{ text }}"
      }
    }
  },
  "output": {
    "contract_version": 2,
    "sink": "ws",
    "schema": "results[]{box,quad,score,text,rec_conf,kind=text} + events[]{kind=text,box,quad,text,score,rec_conf}",
    "topic": "recamera/ppocr-reader/results",
    "default_channel": [
      "ws"
    ],
    "default_mode": "raw",
    "fields": [
      {"name": "kind", "from": "results[].kind", "type": "string", "description": "Result kind, always 'text'"},
      {"name": "box", "from": "results[].box", "type": "bbox<float>[4]", "coord": "pixel_xyxy", "description": "Text box, original-frame xyxy pixels"},
      {"name": "quad", "from": "results[].quad", "type": "quad<float>[4][2]", "coord": "pixel_quad", "description": "Text quadrilateral, original-frame pixels"},
      {"name": "score", "from": "results[].score", "type": "float", "description": "Detection (box) score"},
      {"name": "cls_name", "from": "results[].cls_name", "type": "string", "description": "Literal 'text' tag; NOT the recognized string"},
      {"name": "text", "from": "results[].text", "type": "string", "optional": true, "description": "Recognized string (may be empty). Preferred label source over cls_name"},
      {"name": "rec_conf", "from": "results[].rec_conf", "type": "float", "description": "Recognition (CTC) confidence"},
      {"name": "text_kind", "from": "events[kind=text].kind", "type": "string", "event_kind": "text", "description": "Event kind, always 'text'"},
      {"name": "text_box", "from": "events[kind=text].box", "type": "bbox<float>[4]", "coord": "pixel_xyxy", "event_kind": "text", "description": "Text box of the event"},
      {"name": "text_quad", "from": "events[kind=text].quad", "type": "quad<float>[4][2]", "coord": "pixel_quad", "event_kind": "text", "description": "Text quadrilateral of the event"},
      {"name": "text_text", "from": "events[kind=text].text", "type": "string", "event_kind": "text", "optional": true, "description": "Recognized string of the event (may be empty)"},
      {"name": "text_score", "from": "events[kind=text].score", "type": "float", "event_kind": "text", "description": "Detection score of the event"},
      {"name": "text_rec_conf", "from": "events[kind=text].rec_conf", "type": "float", "event_kind": "text", "description": "Recognition confidence of the event"}
    ],
    "default_mapping": [
      {"source": "events.text | length", "target": "count", "topic": "recamera/{{ app }}/count", "task": "detection"},
      {"source": "events.text | map(attribute='text') | reject('equalto','') | list | last", "target": "last_text", "topic": "recamera/{{ app }}/text", "task": "detection"},
      {"source": "events.text | map(attribute='text') | reject('equalto','') | list", "target": "texts", "topic": "recamera/{{ app }}/text", "task": "detection"}
    ]
  },
  "config_schema": {
    "groups": [
      {
        "key": "detection",
        "title": "Text detection",
        "title_zh": "文本检测",
        "items": [
          {
            "key": "det_thresh",
            "type": "number",
            "apply": "live",
            "title": "Prob-map threshold",
            "title_zh": "概率图阈值",
            "min": 0.1,
            "max": 0.9,
            "step": 0.05,
            "default": 0.3
          },
          {
            "key": "box_thresh",
            "type": "number",
            "apply": "live",
            "title": "Box score threshold",
            "title_zh": "文本框阈值",
            "min": 0.1,
            "max": 0.95,
            "step": 0.05,
            "default": 0.5
          },
          {
            "key": "unclip_ratio",
            "type": "number",
            "apply": "live",
            "title": "Unclip ratio",
            "title_zh": "外扩膨胀比",
            "min": 1.0,
            "max": 3.5,
            "step": 0.1,
            "default": 2.0
          },
          {
            "key": "max_boxes",
            "type": "integer",
            "apply": "live",
            "title": "Max text boxes / frame",
            "title_zh": "每帧最大文本框",
            "min": 1,
            "max": 32,
            "step": 1,
            "default": 8
          }
        ]
      },
      {
        "key": "recognition",
        "title": "Text recognition",
        "title_zh": "文本识别",
        "items": [
          {
            "key": "min_rec_conf",
            "type": "number",
            "apply": "live",
            "title": "Min recognition confidence",
            "title_zh": "识别最低置信度",
            "min": 0.0,
            "max": 0.95,
            "step": 0.05,
            "default": 0.25
          }
        ]
      }
    ]
  },
  "ha_entities": [
    {
      "component": "sensor",
      "object_id": "text_count",
      "name": "Text Block Count",
      "value_template": "{{ value_json.counts_by_kind.text | default(0) }}",
      "state_class": "measurement",
      "icon": "mdi:text-recognition"
    },
    {
      "component": "sensor",
      "object_id": "last_text",
      "name": "Last Recognized Text",
      "value_template": "{{ value_json.summary.text | default('') }}"
    }
  ]
}
