{
  "manifest_version": 2,
  "compatibility": {
    "platform_profile": "rv1126b-linux-gnu-cp311-rknn232-v1",
    "arch": "aarch64",
    "python": "==3.11.*",
    "kit_api": ">=0.1,<1",
    "sdk_abi": ">=1.3,<2",
    "rknn_runtime": "==2.3.2"
  },
  "python": {
    "runtime_profile": "recamera-ai-cp311-v1",
    "isolation": "per-release",
    "wheels": [],
    "imports": []
  },
  "resources": {
    "claims": [
      {
        "name": "camera.frames",
        "mode": "shared",
        "required": true
      },
      {
        "name": "result.publish",
        "mode": "brokered",
        "required": true
      }
    ],
    "limits": {
      "memory_mb": 256,
      "cpu_percent": 300,
      "storage_mb": 1536,
      "shutdown_grace_sec": 15
    }
  },
  "permissions": {
    "sdk": [
      "frame.read",
      "result.publish"
    ],
    "filesystem": {
      "read": [
        "app",
        "appdata",
        "artifacts"
      ],
      "write": [
        "appdata",
        "tmp"
      ]
    },
    "network": {
      "listen": [],
      "outbound": [
        "configured.server_url",
        "device.control"
      ]
    }
  },
  "health": {
    "protocol": "kit-health-v1",
    "startup_timeout_sec": 120,
    "stabilization_sec": 3,
    "liveness_interval_sec": 10,
    "liveness_failures": 3,
    "restart": {
      "policy": "on-failure",
      "max_attempts": 3,
      "window_sec": 300,
      "backoff_sec": [
        1,
        5,
        15
      ]
    }
  },
  "instances": {
    "max": 1,
    "config_scope": "app",
    "data_scope": "app",
    "endpoint_mode": "allocated"
  },
  "id": "cvsprout-capture",
  "name": "CVSprout Link",
  "name_zh": "CVSprout 设备连接",
  "version": "1.1.1",
  "release": {
    "sequence": 5,
    "channel": "stable"
  },
  "type": "self-hosted",
  "author": "CVSprout contributors",
  "entry": "app.py",
  "image": "/appcenter/apps/cvsprout-capture.png",
  "icon": {
    "path": "icon.png",
    "media_type": "image/png"
  },
  "description": "Connect reCamera Pro to CVSprout to upload captured images and deploy compatible trained models, with optional activation on the device.",
  "description_zh": "将 reCamera Pro 接入 CVSprout，采集图片上传至项目，并将兼容的训练模型部署到设备，按需启用推理。",
  "scene": "Data capture & model deployment",
  "scene_zh": "数据采集与模型部署",
  "package": {
    "exclude": [
      "icon.svg"
    ]
  },
  "artifacts": [],
  "models": [],
  "capabilities": [
    "output"
  ],
  "config_schema": {
    "groups": [
      {
        "key": "capture",
        "title": "Platform connection",
        "title_zh": "平台连接",
        "items": [
          {
            "key": "server_url",
            "type": "string",
            "default": "",
            "title": "CVSprout server URL",
            "title_zh": "CVSprout 服务地址",
            "apply": "restart",
            "help_zh": "例如 http://192.168.1.10:8008；远程连接建议使用 HTTPS。"
          },
          {
            "key": "device_token",
            "type": "password",
            "default": "",
            "title": "Device access token",
            "title_zh": "设备专用令牌",
            "apply": "restart",
            "help_zh": "在 CVSprout 设备页面创建；仅限绑定项目，不要使用管理员令牌。"
          },
          {
            "key": "jpeg_quality",
            "type": "integer",
            "default": 90,
            "min": 40,
            "max": 95,
            "title": "JPEG quality",
            "title_zh": "JPEG 质量",
            "apply": "restart"
          },
          {
            "key": "spool_size_mb",
            "type": "integer",
            "default": 128,
            "min": 16,
            "max": 512,
            "title": "Offline queue limit (MiB)",
            "title_zh": "离线队列容量（MiB）",
            "apply": "restart"
          },
          {
            "key": "spool_max_images",
            "type": "integer",
            "default": 1000,
            "min": 10,
            "max": 10000,
            "title": "Offline queue image limit",
            "title_zh": "离线队列图片上限",
            "apply": "restart"
          },
          {
            "key": "max_session_images",
            "type": "integer",
            "default": 0,
            "min": 0,
            "max": 100000,
            "title": "Session capture quota (0 = unlimited)",
            "title_zh": "本次启动采集上限（0 为不限）",
            "apply": "restart"
          }
        ]
      }
    ]
  },
  "output": {
    "contract_version": 2,
    "sink": "ws",
    "schema": "capture_state,pending_images,pending_bytes,uploaded_images,last_error",
    "default_channel": [
      "ws"
    ],
    "default_mode": "raw",
    "fields": [
      {
        "name": "capture_state",
        "from": "capture_state",
        "type": "string",
        "description": "Whether new frames are being sampled"
      },
      {
        "name": "pending_images",
        "from": "pending_images",
        "type": "integer",
        "description": "Unacknowledged images in the persistent queue"
      },
      {
        "name": "pending_bytes",
        "from": "pending_bytes",
        "type": "integer",
        "description": "JPEG bytes waiting for delivery"
      },
      {
        "name": "uploaded_images",
        "from": "uploaded_images",
        "type": "integer",
        "description": "Images acknowledged during this process lifetime"
      },
      {
        "name": "last_error",
        "from": "last_error",
        "type": "string",
        "description": "Sanitized delivery or capacity status"
      }
    ],
    "default_mapping": [
      {
        "source": "capture_state",
        "target": "state",
        "topic": "recamera/{{ app }}/capture"
      }
    ]
  }
}
