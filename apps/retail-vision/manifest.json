{
  "manifest_version": 2,
  "release": {"sequence": 4, "channel": "stable"},
  "compatibility": {"platform_profile": "rv1126b-linux-gnu-cp311-rknn232-v1", "arch": "aarch64", "python": "==3.11.*", "kit_api": ">=0.1,<1", "sdk_abi": ">=1.3,<2", "rknn_runtime": "==2.3.2"},
  "python": {"runtime_profile": "recamera-ai-cp311-v1", "isolation": "per-release", "wheels": [], "imports": []},
  "artifacts": [
    {"id": "detector", "kind": "rknn", "source": "bundled", "file": "models/yolo8n_rawhead_int8.rknn", "sha256": "5379721bb9b16fa3b9caceb8958175b2e8b0665d4ebcfe4e2524ad1db80d30da", "size": 4339284, "mount": "models/yolo8n_rawhead_int8.rknn", "required": true, "share_scope": "content"}
  ],
  "resources": {"claims": [
    {"name": "camera.frames", "mode": "shared", "required": true},
    {"name": "npu.rknn", "mode": "scheduled", "required": true},
    {"name": "rga", "mode": "shared", "required": true},
    {"name": "result.publish", "mode": "brokered", "required": true}
  ], "limits": {"memory_mb": 320, "cpu_percent": 300, "storage_mb": 24, "shutdown_grace_sec": 10}},
  "permissions": {"sdk": ["frame.read", "npu.infer", "rga.use", "result.publish"], "filesystem": {"read": ["app", "artifacts"], "write": ["appdata", "tmp"]}, "network": {"listen": [], "outbound": ["configured.outputs"]}},
  "health": {"protocol": "kit-health-v1", "startup_timeout_sec": 120, "stabilization_sec": 3, "liveness_interval_sec": 10, "liveness_failures": 3, "restart": {"policy": "on-failure", "max_attempts": 3, "window_sec": 300, "backoff_sec": [1, 5, 15]}},
  "instances": {"max": 1, "config_scope": "app", "data_scope": "app", "endpoint_mode": "allocated"},
  "id": "retail-vision",
  "name": "Retail People Counting",
  "name_zh": "零售人流分析",
  "version": "0.1.3",
  "image": "/appcenter/apps/retail-vision.png",
  "icon": {"path": "icon.png", "media_type": "image/png"},
  "type": "self-hosted",
  "scene": "Retail",
  "scene_zh": "零售",
  "description": "On-device retail people-flow analytics. Runs YOLOv8n (person class only) on the RV1126B NPU, tracks each shopper across frames (IoU association + velocity prediction + track id), and turns tracks into the three numbers a store manager asks for: how many came in/out, how many are in the store right now, and who is browsing / engaged / needs assistance. Optional counting zone and directional entry/exit line. Streams tracks + counting events for the /appcenter overlay.",
  "description_zh": "本地零售人流分析。在 RV1126B NPU 上运行 YOLOv8n（只取 person 类），跨帧跟踪每位顾客（IoU 关联 + 速度预测 + track id），把轨迹转化为门店最关心的三个数字：进/出多少人、当前在店多少人、谁在浏览/驻足/需要帮助。可选统计区域与有向进出计数线。向 /appcenter 叠加层输出轨迹与计数事件。",
  "author": "Seeed reCamera Pro",
  "entry": "app.py",
  "capabilities": [
    "output"
  ],
  "record_trigger": {
    "version": 1,
    "signals": [
      {"id": "person", "type": "detection", "classes": ["person"], "supports_roi": true},
      {"id": "line-cross", "type": "event", "event_kind": "line_cross", "supports_roi": false}
    ]
  },
  "models": [
    {
      "id": "yolo8n_rawhead_int8",
      "file": "models/yolo8n_rawhead_int8.rknn",
      "task": "detect",
      "input": [
        1,
        640,
        640,
        3
      ],
      "quant": "int8",
      "classes": "coco80"
    }
  ],
  "x-default_model": "yolo8n_rawhead_int8",
  "postproc": "detect",
  "render": {
    "schema_version": 1,
    "boxes": {
      "color_by": "cls_name",
      "label": "cls_name",
      "line_width": 2
    },
    "events": {
      "line_cross": {
        "as": "toast",
        "position": "top-center",
        "duration_sec": 2,
        "text": "{{ dir }} #{{ track_id }}"
      },
      "metrics": {
        "as": "panel",
        "position": "top-left",
        "fields": ["occupancy", "entry_count", "exit_count", "peak"]
      }
    },
    "stream_osd": {"supported": ["boxes"], "default": false}
  },
  "output": {
    "contract_version": 2,
    "sink": "ws",
    "schema": "results[]{box,cls,cls_name,score,kind=person|detection} + events[]{kind=track|line_cross|metrics,track_id,box,state,dir,occupancy,entry_count,exit_count,peak,browsing,engaged,assistance}",
    "default_channel": [
      "ws"
    ],
    "default_mode": "raw",
    "fields": [
      {"name": "box", "from": "results[].box", "type": "bbox<float>[4]", "coord": "pixel_xyxy", "description": "Raw detection box, original-frame xyxy pixels"},
      {"name": "cls", "from": "results[].cls", "type": "integer", "description": "COCO-80 class id; cls==0 is person (results[].kind is tagged accordingly)"},
      {"name": "cls_name", "from": "results[].cls_name", "type": "string", "description": "COCO-80 class label"},
      {"name": "score", "from": "results[].score", "type": "float", "description": "Detection confidence"},
      {"name": "kind", "from": "results[].kind", "type": "string", "description": "Tagged 'person' after class-0-only tracking; prefer cls==0"},
      {"name": "track_id", "from": "events[kind=track].track_id", "type": "integer", "event_kind": "track", "description": "Stable per-shopper track id"},
      {"name": "track_state", "from": "events[kind=track].state", "type": "string", "event_kind": "track", "description": "Track dwell state (browsing/engaged/assistance)"},
      {"name": "track_in_zone", "from": "events[kind=track].in_zone", "type": "bool", "event_kind": "track", "description": "Whether the track is inside the counting zone"},
      {"name": "track_score", "from": "events[kind=track].score", "type": "float", "event_kind": "track", "description": "Track detection confidence"},
      {"name": "track_speed_px_s", "from": "events[kind=track].speed_px_s", "type": "float", "event_kind": "track", "description": "Track speed in pixels/second"},
      {"name": "track_box", "from": "events[kind=track].box", "type": "bbox<float>[4]", "coord": "pixel_xyxy", "event_kind": "track", "description": "Track box, original-frame pixels"},
      {"name": "line_cross_track_id", "from": "events[kind=line_cross].track_id", "type": "integer", "event_kind": "line_cross", "description": "Track id that crossed the entry/exit line"},
      {"name": "line_cross_dir", "from": "events[kind=line_cross].dir", "type": "string", "event_kind": "line_cross", "description": "Crossing direction (in/out)"},
      {"name": "metrics_occupancy", "from": "events[kind=metrics].occupancy", "type": "integer", "event_kind": "metrics", "description": "People currently in store"},
      {"name": "metrics_browsing", "from": "events[kind=metrics].browsing", "type": "integer", "event_kind": "metrics", "description": "Browsing count"},
      {"name": "metrics_engaged", "from": "events[kind=metrics].engaged", "type": "integer", "event_kind": "metrics", "description": "Engaged count"},
      {"name": "metrics_assistance", "from": "events[kind=metrics].assistance", "type": "integer", "event_kind": "metrics", "description": "Needs-assistance count"},
      {"name": "metrics_peak", "from": "events[kind=metrics].peak", "type": "integer", "event_kind": "metrics", "description": "Peak occupancy in the window"},
      {"name": "metrics_entry_count", "from": "events[kind=metrics].entry_count", "type": "integer", "event_kind": "metrics", "description": "Cumulative entries"},
      {"name": "metrics_exit_count", "from": "events[kind=metrics].exit_count", "type": "integer", "event_kind": "metrics", "description": "Cumulative exits"}
    ],
    "default_mapping": [
      {"source": "results | selectattr('cls','equalto',0) | list | length", "target": "person_count", "topic": "recamera/{{ app }}/count", "task": "detection"},
      {"source": "(events.metrics | last).occupancy", "target": "occupancy", "topic": "recamera/{{ app }}/metrics", "task": "tracking"},
      {"source": "(events.metrics | last).entry_count", "target": "entry_count", "topic": "recamera/{{ app }}/metrics", "task": "tracking"},
      {"source": "(events.metrics | last).exit_count", "target": "exit_count", "topic": "recamera/{{ app }}/metrics", "task": "tracking"},
      {"source": "(events.metrics | last).peak", "target": "peak", "topic": "recamera/{{ app }}/metrics", "task": "tracking"}
    ]
  },
  "config_schema": {
    "groups": [
      {
        "key": "detection",
        "title": "Detection",
        "title_zh": "检测",
        "items": [
          {
            "key": "confidence",
            "type": "number",
            "apply": "live",
            "title": "Person confidence",
            "title_zh": "人体置信度",
            "min": 0.05,
            "max": 0.95,
            "step": 0.05,
            "default": 0.4
          },
          {
            "key": "iou",
            "type": "number",
            "apply": "live",
            "title": "NMS IoU threshold",
            "title_zh": "NMS IoU 阈值",
            "min": 0.1,
            "max": 0.9,
            "step": 0.05,
            "default": 0.45
          }
        ]
      },
      {
        "key": "zone",
        "title": "Counting Zone",
        "title_zh": "统计区域",
        "items": [
          {
            "key": "count_zone",
            "type": "zone",
            "apply": "live",
            "title": "Counting zone",
            "title_zh": "统计区域",
            "maxPoints": 8
          }
        ]
      },
      {
        "key": "line",
        "title": "Entry / Exit Line",
        "title_zh": "进出计数线",
        "items": [
          {
            "key": "entry_line",
            "type": "line",
            "apply": "live",
            "title": "Entry line",
            "title_zh": "进出计数线",
            "directional": true
          }
        ]
      },
      {
        "key": "dwell",
        "title": "Dwell",
        "title_zh": "驻留",
        "items": [
          {
            "key": "dwell_engaged",
            "type": "number",
            "apply": "live",
            "title": "Engaged threshold (s)",
            "title_zh": "驻足阈值（秒）",
            "min": 0.5,
            "max": 30,
            "step": 0.5,
            "default": 1.5
          },
          {
            "key": "dwell_assist",
            "type": "number",
            "apply": "live",
            "title": "Assistance threshold (s)",
            "title_zh": "求助阈值（秒）",
            "min": 5,
            "max": 120,
            "step": 1,
            "default": 20
          },
          {
            "key": "dwell_speed",
            "type": "number",
            "apply": "live",
            "title": "Stationary speed (px/s)",
            "title_zh": "驻留速度阈值（像素/秒）",
            "min": 1,
            "max": 50,
            "step": 1,
            "default": 10
          }
        ]
      },
      {
        "key": "window",
        "title": "Window",
        "title_zh": "统计窗口",
        "items": [
          {
            "key": "window_duration",
            "type": "number",
            "apply": "restart",
            "title": "Rolling window (s)",
            "title_zh": "滚动窗口（秒）",
            "min": 10,
            "max": 600,
            "step": 10,
            "default": 60
          }
        ]
      }
    ]
  },
  "ha_entities": [
    {
      "component": "sensor",
      "object_id": "people_count",
      "name": "People Count",
      "value_template": "{{ value_json.summary.occupancy | default(0) }}",
      "state_class": "measurement",
      "icon": "mdi:account-group"
    },
    {
      "component": "sensor",
      "object_id": "entered_total",
      "name": "People Entered Total",
      "value_template": "{{ value_json.summary.entry_count | default(0) }}",
      "state_class": "total_increasing"
    },
    {
      "component": "sensor",
      "object_id": "exited_total",
      "name": "People Exited Total",
      "value_template": "{{ value_json.summary.exit_count | default(0) }}",
      "state_class": "total_increasing"
    }
  ]
}
