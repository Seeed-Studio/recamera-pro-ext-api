{
  "manifest_version": 2,
  "release": {
    "sequence": 2,
    "channel": "stable"
  },
  "compatibility": {
    "platform_profile": "rv1126b-linux-gnu-cp311-rknn232-v1",
    "arch": "aarch64",
    "python": "==3.11.*",
    "kit_api": ">=0.4,<1",
    "sdk_abi": ">=1.3,<2"
  },
  "python": {
    "runtime_profile": "recamera-ai-cp311-v1",
    "isolation": "per-release",
    "wheels": [],
    "imports": [
      "numpy",
      "recamera_ext"
    ]
  },
  "artifacts": [],
  "resources": {
    "claims": [
      {
        "name": "camera.frames",
        "mode": "shared",
        "required": true
      },
      {
        "name": "result.publish",
        "mode": "brokered",
        "required": true
      }
    ],
    "limits": {
      "memory_mb": 64,
      "cpu_percent": 100,
      "storage_mb": 8,
      "shutdown_grace_sec": 10
    }
  },
  "permissions": {
    "sdk": [
      "frame.read",
      "result.publish"
    ],
    "filesystem": {
      "read": [
        "app",
        "artifacts"
      ],
      "write": [
        "appdata",
        "tmp"
      ]
    },
    "network": {
      "listen": [],
      "outbound": [
        "configured.outputs"
      ]
    }
  },
  "health": {
    "protocol": "kit-health-v1",
    "startup_timeout_sec": 60,
    "stabilization_sec": 2,
    "liveness_interval_sec": 10,
    "liveness_failures": 3,
    "restart": {
      "policy": "on-failure",
      "max_attempts": 3,
      "window_sec": 300,
      "backoff_sec": [
        1,
        5,
        15
      ]
    }
  },
  "instances": {
    "max": 1,
    "config_scope": "app",
    "data_scope": "app",
    "endpoint_mode": "allocated"
  },
  "id": "motion-detect",
  "name": "Motion Detection",
  "version": "1.1.0",
  "image": "/appcenter/apps/motion-detect.png",
  "icon": {
    "path": "icon.png",
    "media_type": "image/png"
  },
  "type": "self-hosted",
  "description": "CPU motion detection with stable Home Assistant MQTT Discovery reporting.",
  "author": "Seeed reCamera Pro",
  "entry": "app.py",
  "capabilities": [],
  "models": [],
  "postproc": "motion",
  "render": {
    "schema_version": 1,
    "geometry": {
      "types": ["point"],
      "max_items": 1,
      "max_points": 1
    }
  },
  "output": {
    "contract_version": 2,
    "sink": "ws",
    "schema": "geometry[]{type,points,id,label,style}",
    "default_channel": ["ws"],
    "default_mode": "raw",
    "fields": [
      {
        "name": "geometry",
        "from": "geometry[]",
        "type": "geometry[]",
        "coord": "normalized_points",
        "description": "Motion status label for the browser preview"
      }
    ],
    "default_mapping": []
  },
  "tags": [
    "motion",
    "cpu",
    "home-assistant"
  ],
  "config_schema": {
    "groups": [
      {
        "key": "detection",
        "title": "Detection",
        "title_zh": "检测判定",
        "items": [
          {
            "key": "sq_diff_threshold",
            "type": "number",
            "apply": "live",
            "title": "Squared-difference threshold",
            "title_zh": "平方差阈值（≈灰度差 20 的平方）",
            "min": 1,
            "max": 65025,
            "step": 50,
            "default": 400
          },
          {
            "key": "min_changed_ratio",
            "type": "number",
            "apply": "live",
            "title": "Minimum changed-pixel ratio",
            "title_zh": "运动判定最小变化像素占比",
            "min": 0,
            "max": 0.5,
            "step": 0.001,
            "default": 0.005
          },
          {
            "key": "motion_hold_ms",
            "type": "integer",
            "apply": "live",
            "title": "Motion hold time (ms)",
            "title_zh": "运动保持时间（毫秒，防抖）",
            "min": 0,
            "max": 600000,
            "step": 100,
            "default": 3000
          }
        ]
      },
      {
        "key": "baseline",
        "title": "Baseline comparison",
        "title_zh": "基准对比",
        "items": [
          {
            "key": "baseline_frames",
            "type": "integer",
            "apply": "live",
            "title": "Baseline window length (frames)",
            "title_zh": "基准画面长度（帧）",
            "min": 1,
            "max": 240,
            "step": 1,
            "default": 5
          },
          {
            "key": "current_frames",
            "type": "integer",
            "apply": "live",
            "title": "Current window length (frames)",
            "title_zh": "当前画面长度（帧）",
            "min": 1,
            "max": 120,
            "step": 1,
            "default": 2
          },
          {
            "key": "baseline_gap_ms",
            "type": "integer",
            "apply": "live",
            "title": "Baseline-to-current gap (ms)",
            "title_zh": "基准与当前画面的时间间隔（毫秒）",
            "min": 0,
            "max": 600000,
            "step": 100,
            "default": 1000
          }
        ]
      },
      {
        "key": "sampling",
        "title": "Sampling and reporting",
        "title_zh": "采样与上报",
        "items": [
          {
            "key": "sample_fps",
            "type": "number",
            "apply": "restart",
            "title": "Sampling rate (fps)",
            "title_zh": "分析采样率（帧/秒，改后自动重启服务）",
            "min": 0.2,
            "max": 30,
            "step": 0.2,
            "default": 5
          },
          {
            "key": "analysis_width",
            "type": "integer",
            "apply": "live",
            "title": "Analysis width (px)",
            "title_zh": "分析分辨率宽度（像素）",
            "min": 32,
            "max": 640,
            "step": 16,
            "default": 160
          },
          {
            "key": "heartbeat_sec",
            "type": "integer",
            "apply": "live",
            "title": "Heartbeat interval (s)",
            "title_zh": "心跳间隔（秒）",
            "min": 5,
            "max": 3600,
            "step": 5,
            "default": 30
          }
        ]
      },
      {
        "key": "uplink",
        "title": "Uplink",
        "title_zh": "上报通道",
        "items": [
          {
            "key": "mqtt_host",
            "type": "string",
            "apply": "live",
            "title": "MQTT broker host (HA)",
            "title_zh": "MQTT broker 地址（接 HA，空=关闭）",
            "default": ""
          },
          {
            "key": "mqtt_port",
            "type": "integer",
            "apply": "live",
            "title": "MQTT broker port",
            "title_zh": "MQTT 端口",
            "min": 1,
            "max": 65535,
            "step": 1,
            "default": 1883
          },
          {
            "key": "mqtt_user",
            "type": "string",
            "apply": "live",
            "title": "MQTT username",
            "title_zh": "MQTT 用户名（可空）",
            "default": ""
          },
          {
            "key": "mqtt_pass",
            "type": "password",
            "apply": "live",
            "title": "MQTT password",
            "title_zh": "MQTT 密码（可空）",
            "default": ""
          }
        ]
      }
    ]
  },
  "name_zh": "移动检测",
  "scene": "Interaction & Control",
  "scene_zh": "交互控制",
  "description_zh": "CPU 移动检测，保留原有 Home Assistant MQTT Discovery 上报协议。预装后默认关闭。",
  "package": {
    "exclude": [
      "tests",
      "deploy",
      "motion_daemon.py",
      "http_control.py",
      "config.json",
      "API.md",
      "README.md"
    ]
  }
}
