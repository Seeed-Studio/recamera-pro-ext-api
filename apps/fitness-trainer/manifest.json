{
  "manifest_version": 2,
  "release": {"sequence": 1, "channel": "stable"},
  "compatibility": {"platform_profile": "rv1126b-linux-gnu-cp311-rknn232-v1", "arch": "aarch64", "python": "==3.11.*", "kit_api": ">=0.1,<1", "sdk_abi": ">=1.3,<2", "rknn_runtime": "==2.3.2"},
  "python": {"runtime_profile": "recamera-ai-cp311-v1", "isolation": "per-release", "wheels": [], "imports": []},
  "artifacts": [
    {"id": "pose-model", "kind": "rknn", "source": "bundled", "file": "models/yolo11n_pose_rawhead_int8.rknn", "sha256": "3629dd1fe6c2229276295ff1050cf4a2cef9892bc87e4d2b50f5bef15bcc8add", "size": 4691086, "mount": "models/yolo11n_pose_rawhead_int8.rknn", "required": true, "share_scope": "content"}
  ],
  "resources": {"claims": [
    {"name": "camera.frames", "mode": "shared", "required": true},
    {"name": "npu.rknn", "mode": "scheduled", "required": true},
    {"name": "rga", "mode": "shared", "required": true},
    {"name": "result.publish", "mode": "brokered", "required": true}
  ], "limits": {"memory_mb": 320, "cpu_percent": 300, "storage_mb": 24, "shutdown_grace_sec": 10}},
  "permissions": {"sdk": ["frame.read", "npu.infer", "rga.use", "result.publish"], "filesystem": {"read": ["app", "artifacts"], "write": ["appdata", "tmp"]}, "network": {"listen": [], "outbound": ["configured.outputs"]}},
  "health": {"protocol": "kit-health-v1", "startup_timeout_sec": 120, "stabilization_sec": 3, "liveness_interval_sec": 10, "liveness_failures": 3, "restart": {"policy": "on-failure", "max_attempts": 3, "window_sec": 300, "backoff_sec": [1, 5, 15]}},
  "instances": {"max": 1, "config_scope": "app", "data_scope": "app", "endpoint_mode": "allocated"},
  "id": "fitness-trainer",
  "name": "Fitness Trainer",
  "name_zh": "健身教练",
  "version": "0.1.0",
  "image": "/appcenter/apps/fitness-trainer.png",
  "type": "self-hosted",
  "scene": "Health & Wellness",
  "scene_zh": "健康健身",
  "description": "Counts your reps and calls out sloppy form, on-device, using YOLO11n-Pose and joint-angle hysteresis state machines. Pick squats, push-ups or hammer curls, set your reps and sets, and the camera does the rest -- no phone, no wearable, no video leaving the device. Streams keypoints and live rep counts for the /appcenter overlay.",
  "description_zh": "使用 YOLO11n-Pose 与关节角迟滞状态机在设备本地数你的组数并提示动作不到位。选择深蹲、俯卧撑或哑铃弯举，设定次数与组数，剩下的交给摄像头——不用手机、不戴手环，画面也不出设备。向 /appcenter 叠加层输出关键点与实时计数。",
  "author": "Seeed reCamera Pro",
  "entry": "app.py",
  "capabilities": [
    "output"
  ],
  "models": [
    {
      "id": "yolo11n_pose_rawhead_int8",
      "file": "models/yolo11n_pose_rawhead_int8.rknn",
      "task": "pose",
      "input": [
        1,
        640,
        640,
        3
      ],
      "quant": "int8",
      "keypoints": "coco17"
    }
  ],
  "x-default_model": "yolo11n_pose_rawhead_int8",
  "postproc": "pose",
  "render": {
    "keypoints": {
      "layout": "coco17",
      "point_radius": 3,
      "line_width": 2,
      "conf_min": 0.3
    },
    "events": {
      "workout": {
        "as": "panel",
        "position": "top-left",
        "fields": ["mode", "reps", "set", "stage"]
      }
    }
  },
  "output": {
    "sink": "ws",
    "schema": "results[]{box,score,keypoints[17][x,y,conf],kind} + events[]{kind=workout,mode,reps,set,target_reps,target_sets,stage,angle,tracking,rep_completed,set_completed,workout_complete,form_warning,...}",
    "default_channel": [
      "ws"
    ],
    "default_mode": "raw",
    "fields": [
      {"name": "box", "from": "results[].box", "type": "bbox<float>[4]", "coord": "pixel_xyxy", "description": "Person box, original-frame xyxy pixels"},
      {"name": "score", "from": "results[].score", "type": "float", "description": "Person detection confidence"},
      {"name": "keypoints", "from": "results[].keypoints", "type": "keypoints<float>[17]", "description": "COCO-17 pose keypoints"},
      {"name": "kind", "from": "results[].kind", "type": "string", "description": "Result kind, always 'person'"},
      {"name": "workout_kind", "from": "events[kind=workout].kind", "type": "string", "event_kind": "workout", "description": "Event kind, always 'workout'"},
      {"name": "workout_mode", "from": "events[kind=workout].mode", "type": "string", "event_kind": "workout", "description": "Exercise mode"},
      {"name": "workout_reps", "from": "events[kind=workout].reps", "type": "integer", "event_kind": "workout", "description": "Reps in the current set"},
      {"name": "workout_set", "from": "events[kind=workout].set", "type": "integer", "event_kind": "workout", "description": "Current set index"},
      {"name": "workout_target_reps", "from": "events[kind=workout].target_reps", "type": "integer", "event_kind": "workout", "description": "Target reps per set"},
      {"name": "workout_target_sets", "from": "events[kind=workout].target_sets", "type": "integer", "event_kind": "workout", "description": "Target sets"},
      {"name": "workout_stage", "from": "events[kind=workout].stage", "type": "string", "event_kind": "workout", "description": "Rep phase (up/down)"},
      {"name": "workout_angle", "from": "events[kind=workout].angle", "type": "float", "event_kind": "workout", "description": "Tracked joint angle"},
      {"name": "workout_has_angle", "from": "events[kind=workout].has_angle", "type": "bool", "event_kind": "workout", "description": "Whether a joint angle is available"},
      {"name": "workout_tracking", "from": "events[kind=workout].tracking", "type": "bool", "event_kind": "workout", "description": "Whether a person is being tracked"},
      {"name": "workout_rep_completed", "from": "events[kind=workout].rep_completed", "type": "bool", "event_kind": "workout", "description": "A rep completed this frame"},
      {"name": "workout_set_completed", "from": "events[kind=workout].set_completed", "type": "bool", "event_kind": "workout", "description": "A set completed this frame"},
      {"name": "workout_workout_complete", "from": "events[kind=workout].workout_complete", "type": "bool", "event_kind": "workout", "description": "Whole workout complete"},
      {"name": "workout_form_warning", "from": "events[kind=workout].form_warning", "type": "string", "event_kind": "workout", "optional": true, "description": "Form-correction warning"},
      {"name": "workout_reps_left", "from": "events[kind=workout].reps_left", "type": "integer", "event_kind": "workout", "optional": true, "description": "Left-side reps (bilateral exercises)"},
      {"name": "workout_reps_right", "from": "events[kind=workout].reps_right", "type": "integer", "event_kind": "workout", "optional": true, "description": "Right-side reps (bilateral exercises)"}
    ],
    "default_mapping": [
      {"source": "(events.workout | last).mode", "target": "mode", "topic": "recamera/{{ app }}/workout", "task": "keypoint"},
      {"source": "(events.workout | last).reps", "target": "reps", "topic": "recamera/{{ app }}/workout", "task": "keypoint"},
      {"source": "(events.workout | last).set", "target": "set", "topic": "recamera/{{ app }}/workout", "task": "keypoint"},
      {"source": "(events.workout | last).stage", "target": "stage", "topic": "recamera/{{ app }}/workout", "task": "keypoint"},
      {"source": "(events.workout | last).angle", "target": "angle", "topic": "recamera/{{ app }}/workout", "task": "keypoint"},
      {"source": "(events.workout | last).tracking", "target": "tracking", "topic": "recamera/{{ app }}/workout", "task": "keypoint"},
      {"source": "(events.workout | last).workout_complete", "target": "workout_complete", "topic": "recamera/{{ app }}/workout", "task": "keypoint"},
      {"source": "(events.workout | last).form_warning", "target": "form_warning", "topic": "recamera/{{ app }}/workout", "task": "keypoint"}
    ]
  },
  "config_schema": {
    "groups": [
      {
        "key": "workout",
        "title": "Workout",
        "title_zh": "训练设置",
        "items": [
          {
            "key": "mode",
            "type": "enum",
            "apply": "live",
            "title": "Exercise",
            "title_zh": "运动模式",
            "options": [
              "squat",
              "push_up",
              "hammer_curl"
            ],
            "option_labels": [
              "Squat",
              "Push-up",
              "Hammer Curl"
            ],
            "option_labels_zh": [
              "深蹲",
              "俯卧撑",
              "哑铃弯举"
            ],
            "default": "squat"
          },
          {
            "key": "target_reps",
            "type": "integer",
            "apply": "live",
            "title": "Reps per set",
            "title_zh": "每组次数",
            "min": 1,
            "max": 100,
            "step": 1,
            "default": 12
          },
          {
            "key": "target_sets",
            "type": "integer",
            "apply": "live",
            "title": "Sets",
            "title_zh": "组数",
            "min": 1,
            "max": 20,
            "step": 1,
            "default": 3
          },
          {
            "key": "idle_reset_seconds",
            "type": "number",
            "apply": "live",
            "title": "Reset after idle (seconds, 0 = never)",
            "title_zh": "无人后重置计数（秒，0 = 不重置）",
            "min": 0,
            "max": 3600,
            "step": 10,
            "default": 60
          }
        ]
      },
      {
        "key": "detection",
        "title": "Detection",
        "title_zh": "检测",
        "items": [
          {
            "key": "confidence",
            "type": "number",
            "apply": "live",
            "title": "Person confidence threshold",
            "title_zh": "人体置信度阈值",
            "min": 0.05,
            "max": 0.95,
            "step": 0.05,
            "default": 0.4
          },
          {
            "key": "keypoint_confidence",
            "type": "number",
            "apply": "live",
            "title": "Keypoint confidence threshold",
            "title_zh": "关键点置信度阈值",
            "min": 0.05,
            "max": 0.95,
            "step": 0.05,
            "default": 0.5
          }
        ]
      }
    ]
  },
  "ha_entities": [
    {
      "component": "sensor",
      "object_id": "reps",
      "name": "Reps",
      "value_template": "{{ value_json.summary.reps | default(0) }}",
      "state_class": "measurement",
      "icon": "mdi:counter"
    },
    {
      "component": "sensor",
      "object_id": "set",
      "name": "Set",
      "value_template": "{{ value_json.summary.set | default(0) }}",
      "state_class": "measurement"
    },
    {
      "component": "sensor",
      "object_id": "exercise",
      "name": "Exercise",
      "value_template": "{{ value_json.summary.mode | default('') }}",
      "icon": "mdi:dumbbell"
    },
    {
      "component": "sensor",
      "object_id": "stage",
      "name": "Stage",
      "value_template": "{{ value_json.summary.stage | default('') }}"
    },
    {
      "component": "binary_sensor",
      "object_id": "workout_complete",
      "name": "Workout Complete",
      "value_template": "{{ 'ON' if value_json.summary.workout_complete else 'OFF' }}"
    }
  ]
}
