{
  "manifest_version": 2,
  "release": {"sequence": 2, "channel": "stable"},
  "compatibility": {
    "platform_profile": "rv1126b-linux-gnu-cp311-rknn232-v1",
    "arch": "aarch64",
    "python": "==3.11.*",
    "kit_api": ">=0.1,<1",
    "sdk_abi": ">=1.3,<2",
    "rknn_runtime": "==2.3.2"
  },
  "python": {
    "runtime_profile": "recamera-ai-cp311-v1",
    "isolation": "per-release",
    "wheels": [],
    "imports": []
  },
  "artifacts": [
    {
      "id": "face-detector",
      "kind": "rknn",
      "source": "bundled",
      "file": "models/yolov8n_face_rawhead_fp16.rknn",
      "sha256": "2bd39fb861b4ceb9cfa8a2d1b5c7c8d83a9d4a711636ccb3a88c1aec0801a524",
      "size": 7106678,
      "mount": "models/yolov8n_face_rawhead_fp16.rknn",
      "required": true,
      "share_scope": "content"
    },
    {
      "id": "fairface",
      "kind": "rknn",
      "source": "bundled",
      "file": "models/fairface_fp16.rknn",
      "sha256": "e37aadc6b6e15a7a16c521b2a90b1557b454e9dd8d7d150abdda05be6ee04bf7",
      "size": 42796144,
      "mount": "models/fairface_fp16.rknn",
      "required": true,
      "share_scope": "content"
    },
    {
      "id": "emotion",
      "kind": "rknn",
      "source": "bundled",
      "file": "models/emotion_enet_b0_fp16.rknn",
      "sha256": "32b33fe438b658f6a06d4e18ab150ab319e9f05f26ba52fd2738bc5fc82d3df0",
      "size": 10479599,
      "mount": "models/emotion_enet_b0_fp16.rknn",
      "required": true,
      "share_scope": "content"
    }
  ],
  "resources": {
    "claims": [
      {"name": "camera.frames", "mode": "shared", "required": true},
      {"name": "npu.rknn", "mode": "scheduled", "required": true},
      {"name": "rga", "mode": "shared", "required": true},
      {"name": "result.publish", "mode": "brokered", "required": true}
    ],
    "limits": {"memory_mb": 512, "cpu_percent": 300, "storage_mb": 96, "shutdown_grace_sec": 10}
  },
  "permissions": {
    "sdk": ["frame.read", "npu.infer", "rga.use", "result.publish"],
    "filesystem": {"read": ["app", "artifacts"], "write": ["appdata", "tmp"]},
    "network": {"listen": [], "outbound": ["configured.outputs"]}
  },
  "health": {
    "protocol": "kit-health-v1",
    "startup_timeout_sec": 120,
    "stabilization_sec": 3,
    "liveness_interval_sec": 10,
    "liveness_failures": 3,
    "restart": {"policy": "on-failure", "max_attempts": 3, "window_sec": 300, "backoff_sec": [1, 5, 15]}
  },
  "instances": {"max": 1, "config_scope": "app", "data_scope": "app", "endpoint_mode": "allocated"},
  "id": "face-analysis",
  "name": "Face Analysis",
  "name_zh": "客群分析",
  "version": "0.1.1",
  "image": "/appcenter/apps/face-analysis.png",
  "type": "self-hosted",
  "scene": "Retail & Audience",
  "scene_zh": "零售客群",
  "description": "On-device audience analytics with a three-stage face cascade: a YOLOv8n-face detector finds every face, then per face a FairFace classifier (age band / gender / race) and an 8-class emotion model run on the cropped 224x224 ROI. Emits per-face attribute events plus a simple time-windowed demographic aggregation (gender / age / race / emotion histograms). Privacy-first: faces can be flagged for blurring and no image leaves the device. Reuses the reCamera Pro cascade-pipeline pattern first shipped by facemesh-reader.",
  "description_zh": "设备端客群分析，采用三级人脸级联：YOLOv8n-face 检测每一张脸，随后对每张脸在裁剪的 224x224 ROI 上运行 FairFace 分类器（年龄段/性别/种族）与 8 类情绪模型。输出每张脸的属性事件，以及简单的分时段客群聚合（性别/年龄/种族/情绪直方图）。隐私优先：可标记人脸进行模糊，且图像不出设备。复用 facemesh-reader 首发的 reCamera Pro 级联流水线范式。",
  "author": "Seeed reCamera Pro",
  "entry": "app.py",
  "capabilities": [
    "output"
  ],
  "models": [
    {
      "id": "yolov8n_face_rawhead_fp16",
      "file": "models/yolov8n_face_rawhead_fp16.rknn",
      "task": "detect",
      "input": [
        1,
        640,
        640,
        3
      ],
      "quant": "fp16",
      "classes": [
        "face"
      ],
      "role": "stage1_detector"
    },
    {
      "id": "fairface_fp16",
      "file": "models/fairface_fp16.rknn",
      "task": "classify",
      "input": [
        1,
        224,
        224,
        3
      ],
      "quant": "fp16",
      "heads": {
        "race": 7,
        "gender": 2,
        "age": 9
      },
      "norm": "imagenet-baked",
      "role": "stage2_fairface"
    },
    {
      "id": "emotion_enet_b0_fp16",
      "file": "models/emotion_enet_b0_fp16.rknn",
      "task": "classify",
      "input": [
        1,
        224,
        224,
        3
      ],
      "quant": "fp16",
      "classes": [
        "Anger",
        "Contempt",
        "Disgust",
        "Fear",
        "Happiness",
        "Neutral",
        "Sadness",
        "Surprise"
      ],
      "norm": "imagenet-baked",
      "role": "stage3_emotion"
    }
  ],
  "x-default_model": "yolov8n_face_rawhead_fp16",
  "postproc": "face_detect",
  "render": {
    "schema_version": 1,
    "boxes": {"color_by": "emotion", "label": "gender", "line_width": 2},
    "events": {
      "demographics": {
        "as": "panel",
        "position": "top-left",
        "fields": ["faces", "gender", "age", "race", "emotion"]
      }
    },
    "stream_osd": {"supported": ["boxes"], "default": false}
  },
  "output": {
    "contract_version": 2,
    "sink": "ws",
    "schema": "results[]{box,score,blur,gender,gender_conf,age,age_conf,race,race_conf,emotion,emotion_conf} + events[]{kind=face|demographics,...}",
    "topic": "recamera/face-analysis/results",
    "default_channel": [
      "ws"
    ],
    "default_mode": "raw",
    "fields": [
      {"name": "box", "from": "results[].box", "type": "bbox<float>[4]", "coord": "pixel_xyxy", "description": "Face box, original-frame xyxy pixels"},
      {"name": "score", "from": "results[].score", "type": "float", "description": "Face detection confidence"},
      {"name": "kind", "from": "results[].kind", "type": "string", "description": "Result kind, always 'face'"},
      {"name": "blur", "from": "results[].blur", "type": "bool", "description": "Whether the face is flagged for privacy blur"},
      {"name": "gender", "from": "results[].gender", "type": "string", "description": "Predicted gender label"},
      {"name": "gender_conf", "from": "results[].gender_conf", "type": "float", "description": "Gender confidence"},
      {"name": "age", "from": "results[].age", "type": "string", "description": "Predicted age band"},
      {"name": "age_conf", "from": "results[].age_conf", "type": "float", "description": "Age confidence"},
      {"name": "race", "from": "results[].race", "type": "string", "description": "Predicted race label"},
      {"name": "race_conf", "from": "results[].race_conf", "type": "float", "description": "Race confidence"},
      {"name": "emotion", "from": "results[].emotion", "type": "string", "optional": true, "description": "Predicted emotion label (only on emotion frames)"},
      {"name": "emotion_conf", "from": "results[].emotion_conf", "type": "float", "optional": true, "description": "Emotion confidence"},
      {"name": "demographics_window_sec", "from": "events[kind=demographics].window_sec", "type": "float", "event_kind": "demographics", "description": "Aggregation window length in seconds"},
      {"name": "demographics_faces", "from": "events[kind=demographics].faces", "type": "integer", "event_kind": "demographics", "description": "Faces counted in the window"},
      {"name": "demographics_gender", "from": "events[kind=demographics].gender", "type": "object<number>", "event_kind": "demographics", "description": "Gender histogram over the window"},
      {"name": "demographics_age", "from": "events[kind=demographics].age", "type": "object<number>", "event_kind": "demographics", "description": "Age-band histogram over the window"},
      {"name": "demographics_race", "from": "events[kind=demographics].race", "type": "object<number>", "event_kind": "demographics", "description": "Race histogram over the window"},
      {"name": "demographics_emotion", "from": "events[kind=demographics].emotion", "type": "object<number>", "event_kind": "demographics", "optional": true, "description": "Emotion histogram over the window"}
    ],
    "default_mapping": [
      {"source": "detection.count", "target": "face_count", "topic": "recamera/{{ app }}/count", "task": "detection"},
      {"source": "events.demographics | last", "target": "demographics", "topic": "recamera/{{ app }}/demographics", "task": "classification"}
    ]
  },
  "config_schema": {
    "groups": [
      {
        "key": "detection",
        "title": "Face detection",
        "title_zh": "人脸检测",
        "items": [
          {
            "key": "confidence",
            "type": "number",
            "apply": "live",
            "title": "Face confidence",
            "title_zh": "人脸置信度",
            "min": 0.05,
            "max": 0.95,
            "step": 0.05,
            "default": 0.4
          },
          {
            "key": "iou",
            "type": "number",
            "apply": "live",
            "title": "NMS IoU",
            "title_zh": "NMS IoU",
            "min": 0.1,
            "max": 0.9,
            "step": 0.05,
            "default": 0.45
          },
          {
            "key": "max_faces",
            "type": "integer",
            "apply": "live",
            "title": "Max faces / frame",
            "title_zh": "每帧最大人脸数",
            "min": 1,
            "max": 16,
            "step": 1,
            "default": 5
          },
          {
            "key": "crop_pad",
            "type": "number",
            "apply": "live",
            "title": "Face ROI padding",
            "title_zh": "人脸 ROI 外扩",
            "min": 0.0,
            "max": 1.0,
            "step": 0.05,
            "default": 0.15
          }
        ]
      },
      {
        "key": "attributes",
        "title": "Attribute analysis",
        "title_zh": "属性分析",
        "items": [
          {
            "key": "emotion_interval",
            "type": "integer",
            "apply": "live",
            "title": "Emotion every N frames",
            "title_zh": "情绪每 N 帧",
            "min": 1,
            "max": 10,
            "step": 1,
            "default": 1
          },
          {
            "key": "aggregate_window_sec",
            "type": "number",
            "apply": "restart",
            "title": "Aggregation window (s)",
            "title_zh": "聚合窗口（秒）",
            "min": 5.0,
            "max": 300.0,
            "step": 5.0,
            "default": 30.0
          }
        ]
      },
      {
        "key": "privacy",
        "title": "Privacy",
        "title_zh": "隐私",
        "items": [
          {
            "key": "privacy_blur",
            "type": "boolean",
            "apply": "live",
            "title": "Blur faces in overlay",
            "title_zh": "叠加层模糊人脸",
            "default": true
          }
        ]
      }
    ]
  },
  "ha_entities": [
    {
      "component": "sensor",
      "object_id": "face_count",
      "name": "Face Count",
      "value_template": "{{ value_json.results_count }}",
      "state_class": "measurement",
      "icon": "mdi:face-recognition"
    },
    {
      "component": "binary_sensor",
      "object_id": "occupancy",
      "name": "Face Detected",
      "value_template": "{{ 'ON' if value_json.results_count > 0 else 'OFF' }}",
      "device_class": "occupancy"
    }
  ]
}
