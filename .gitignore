# 系统/编辑器
.DS_Store
__pycache__/
*.pyc
*.bak
*.swp

# 模型权重/产物(体积大,用别的方式分发,不进 git)
*.rknn
*.caffemodel
*.prototxt
*.onnx
models/
apps/*/models/
# The compact learned fall gate is source-controlled so an app package can be
# reproduced without running the training/export tool. Large RKNN files remain
# ignored by the extensions above.
!apps/fall-detection/models/
apps/fall-detection/models/*
!apps/fall-detection/models/temporal_yolo11s_pose_v1.json.gz
!apps/fall-detection/models/temporal_recamera_pro_rknn_v1.json.gz

# 应用中心后端(market/)：追踪源码，忽略构建产物/大文件/临时
# (dist/、models/、__pycache__/、*.pyc、_local_backups/、.DS_Store 由上方全局规则覆盖)
market/packaging/dist/
market/packaging/models/
market/_local_backups/

# 大资源目录(应用素材/市场包)
*.mp4
*.avi

# 内部规划/设计/交付报告(本地留存,不进公开仓)
internal/

# 本地备份(移入的 *.bak / 旧 scratch,保留可回溯,不进 git)
_local_backups/

# 打包产物(可再生)
dist/
.pytest_cache/

# SDK 构建产物(源在 sdk/,build 是编出来的)
sdk/**/build/

# release 二进制(固件/前端/wheels/tar)走 CDN 分发,不进 git;
# 版本目录只保留 README(发布说明 + md5 校验表)入库,沿用 v1.4/v1.5 惯例。
# 交接给同事的源码 bundle 与本地中转/暂存产物同样不进 git。
# 注意:.gitignore 不支持行内注释,注释必须独占一行。
release/handoff-*/
release/staging-*/
release/verify-*/
release/**/*.tar
release/**/*.tar.gz
release/**/*.bundle
apps/face-recognition/evaluation/data/
